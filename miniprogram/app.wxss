page {
  --color-brand: #347d6d;
  --color-brand-dark: #16483d;
  --color-brand-soft: #e6f0eb;
  --color-warning: #ffc107;
  --color-danger: #c81e1e;
  --color-text: #34443e;
  --color-text-strong: #17241f;
  --color-text-muted: #748079;
  --color-border: #e1e3dc;
  --radius-button: 20rpx;
  --radius-card: 26rpx;
  --space-xs: 10rpx;
  --space-base: 20rpx;
  --space-md: 30rpx;
  --space-lg: 40rpx;
  min-height: 100vh;
  background: #f5f2eb;
  color: var(--color-text-strong);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  background: #f5f2eb;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.topbar > view:first-child {
  min-width: 0;
  flex: 1;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  max-width: 100%;
  justify-content: flex-start;
  flex-wrap: wrap;
}

.title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #17241f;
  word-break: keep-all;
  white-space: normal;
}

.subtitle {
  margin-top: 8rpx;
  color: #74807a;
  font-size: 24rpx;
  line-height: 1.45;
}

.card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: var(--space-base);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 54, 48, 0.055);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #182420;
  margin-bottom: 14rpx;
}

.link-text {
  color: var(--color-brand);
  font-size: 24rpx;
  font-weight: 800;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric {
  width: calc((100% - 16rpx) / 2);
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--color-brand-soft);
  border: 1rpx solid #d5e7fb;
  min-height: 144rpx;
}

.tappable {
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tappable:active,
.nav-card:active,
.list-item:active {
  opacity: 0.78;
  transform: scale(0.99);
}

.metric-value {
  display: block;
  color: var(--color-brand-dark);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 6rpx;
  display: block;
  color: #46627f;
  font-size: 23rpx;
  line-height: 1.35;
}

.metric-action {
  margin-top: 8rpx;
  display: block;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 700;
}

.list-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #e1ebf8;
}

.list-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.row > view:first-child {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text-strong);
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 90rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #137a3d;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.badge.warn {
  background: #fff5d9;
  color: #a06500;
}

.badge.danger {
  background: #ffe8e8;
  color: #c81e1e;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

button {
  margin: 0;
  min-height: 88rpx;
  border-radius: var(--radius-button);
  padding: 0 28rpx;
  border: 1rpx solid #d6dfda;
  background: #eef2ef;
  color: #294239;
  font-weight: 800;
  font-size: 26rpx;
  line-height: 88rpx;
}

button.primary {
  background: linear-gradient(135deg, #1c584b 0%, #123f36 100%);
  border-color: var(--color-brand-dark);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(22, 72, 61, 0.16);
}

button.mini {
  min-height: 88rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  line-height: 88rpx;
  min-width: 150rpx;
}

button.danger {
  background: #fff0f0;
  border-color: #ffb4b4;
  color: #c81e1e;
}

button[disabled] {
  opacity: 0.55;
}

input,
textarea {
  width: 100%;
  min-height: 88rpx;
  border-radius: 18rpx;
  padding: 0 22rpx;
  color: var(--color-text-strong);
  background: #f8f7f3;
  border: 1rpx solid #dcded7;
}

textarea {
  min-height: 130rpx;
  padding-top: 18rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #53635c;
  font-size: 24rpx;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.form-grid .field {
  width: calc((100% - 16rpx) / 2);
  margin-bottom: 0;
}

.nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.nav-card {
  width: calc((100% - 16rpx) / 2);
  min-height: 144rpx;
  padding: 22rpx;
  border: 1rpx solid #d5e7fb;
  border-radius: 18rpx;
  background: #f8fbff;
}

.nav-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #12325b;
}

.nav-meta {
  margin-top: 10rpx;
  display: block;
  color: #5d7292;
  font-size: 22rpx;
}

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #7a8da8;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef6ff;
  border: 1rpx solid #d5e7fb;
  color: #12325b;
  font-size: 24rpx;
  font-weight: 800;
}

.chip.active {
  background: var(--color-brand-dark);
  border-color: var(--color-brand-dark);
  color: #ffffff;
}

.wide-action,
.booking-button,
.confirm-button {
  width: 100%;
  margin-top: 18rpx;
}

.right-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

@media (max-width: 360px) {
  .page {
    padding: 22rpx;
  }

  .top-actions {
    width: 100%;
  }

  .topbar {
    flex-direction: column;
  }

  .title {
    font-size: 38rpx;
  }

  .metric,
  .form-grid .field,
  .nav-card {
    width: 100%;
  }
}


.hero-card {
  border-color: #b9d8ff;
  background: linear-gradient(180deg, #ffffff 0%, #f4f9ff 100%);
}

.text-danger {
  color: #c81e1e !important;
}

.text-warn {
  color: #a06500 !important;
}

.picker-box {
  width: 100%;
  min-height: 88rpx;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  color: var(--color-text-strong);
  background: #f8fbff;
  border: 1rpx solid #c9dbf2;
}

.recommend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e1ebf8;
}

.recommend:first-child {
  border-top: 0;
  padding-top: 0;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(16, 35, 63, 0.42);
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(16, 35, 63, 0.2);
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-strong);
}

.modal-meta {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.status-filter {
  margin: 16rpx 0;
}

/* V1.4 role-first interface */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 6rpx 2rpx 28rpx;
}

.eyebrow {
  margin-bottom: 6rpx;
  color: #6f7c75;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e4e3dc;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 10rpx 28rpx rgba(42, 54, 48, .05);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-head > view:first-child {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: #182420;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 850;
}

.section-note {
  margin-top: 5rpx;
  color: #7c8781;
  font-size: 21rpx;
  line-height: 1.4;
}

.text-link {
  color: #176f63;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  padding: 8rpx 13rpx;
  border-radius: 12rpx;
  background: #e8f4ef;
  color: #176f63;
  font-size: 19rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status.warn {
  background: #fff2d9;
  color: #9b6511;
}

.status.muted {
  background: #eef0ee;
  color: #7c8581;
}

.calm-empty {
  padding: 36rpx 12rpx;
  color: #87918c;
  text-align: center;
  font-size: 22rpx;
}

button.block-button {
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

button.block-button.quiet {
  background: #f1f3f1;
  border-color: #e1e5e2;
  color: #5e6c66;
}

.profile-strip{display:flex;align-items:center;gap:16rpx;margin:-4rpx 0 18rpx;padding:16rpx 18rpx;border:1rpx solid #e3e4dd;border-radius:22rpx;background:rgba(255,255,255,.88)}
.profile-strip>image,.profile-fallback{width:66rpx;height:66rpx;flex-shrink:0;border-radius:20rpx}
.profile-fallback{display:flex;align-items:center;justify-content:center;background:#e0eee7;color:#176f63;font-size:22rpx;font-weight:950}
.profile-strip>view:nth-child(2){min-width:0;flex:1}
.profile-name{font-size:24rpx;font-weight:900}
.profile-note{margin-top:4rpx;color:#7b8781;font-size:19rpx;line-height:1.4}
.profile-strip>text{color:#8b948f;font-size:34rpx}
.profile-mask{align-items:flex-end;padding:0}
.profile-card{border-radius:32rpx 32rpx 0 0;padding-bottom:calc(34rpx + env(safe-area-inset-bottom));text-align:left}
.avatar-button{width:150rpx;height:150rpx;margin:26rpx auto;padding:0;overflow:hidden;border-radius:44rpx;line-height:150rpx}
.avatar-button image,.avatar-button view{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#e2eee8;color:#176f63;font-size:22rpx;font-weight:900}
.profile-card .modal-title,.profile-card .modal-meta{text-align:center}
.developer-readonly{display:flex;align-items:center;gap:12rpx;margin-bottom:16rpx;padding:15rpx 17rpx;border-radius:18rpx;background:#eee7da;color:#5d5547;font-size:20rpx}.developer-readonly>text:first-child{padding:6rpx 9rpx;border-radius:9rpx;background:#d6b777;color:#173d35;font-weight:950}.developer-readonly>view{min-width:0;flex:1;font-weight:850}.developer-readonly>text:last-child{color:#176f63;font-weight:900}
.member-list-avatar{width:48rpx;height:48rpx;flex-shrink:0;border-radius:14rpx;background:#eaf3ef}

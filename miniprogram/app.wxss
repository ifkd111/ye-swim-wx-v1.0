page {
  min-height: 100vh;
  background: #07111f;
  color: #f7fbff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background: #07111f;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
  color: #f8fbff;
}

.subtitle {
  margin-top: 8rpx;
  color: #8ea5c4;
  font-size: 24rpx;
}

.card {
  border: 1rpx solid #1a2a42;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #0c1728;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 14rpx;
}

.link-text {
  color: #67e8f9;
  font-size: 24rpx;
  font-weight: 800;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.metric {
  padding: 22rpx;
  border-radius: 12rpx;
  background: #101f34;
  border: 1rpx solid #1d314d;
}

.tappable {
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tappable:active,
.nav-card:active,
.list-item:active {
  opacity: 0.78;
  transform: scale(0.99);
}

.metric-value {
  display: block;
  color: #67e8f9;
  font-size: 40rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 6rpx;
  display: block;
  color: #91a8c5;
  font-size: 23rpx;
}

.list-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #17263d;
}

.list-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 800;
}

.meta {
  margin-top: 6rpx;
  color: #91a8c5;
  font-size: 23rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 90rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #11311f;
  color: #86efac;
  font-size: 22rpx;
  font-weight: 800;
}

.badge.warn {
  background: #3b2d0a;
  color: #fde68a;
}

.badge.danger {
  background: #3a1118;
  color: #fecaca;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

button {
  margin: 0;
  min-height: 76rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  border: 1rpx solid #243953;
  background: #13223a;
  color: #f8fbff;
  font-weight: 800;
  font-size: 26rpx;
}

button.primary {
  background: #14b8a6;
  border-color: #14b8a6;
  color: #04201e;
}

button.mini {
  min-height: 62rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

button.danger {
  background: #451722;
  border-color: #6f2638;
  color: #fecaca;
}

button[disabled] {
  opacity: 0.55;
}

input,
textarea {
  width: 100%;
  min-height: 78rpx;
  border-radius: 14rpx;
  padding: 0 22rpx;
  color: #f8fbff;
  background: #0a1322;
  border: 1rpx solid #223650;
}

textarea {
  min-height: 130rpx;
  padding-top: 18rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #bdd0e8;
  font-size: 24rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.form-grid .field {
  margin-bottom: 0;
}

.nav-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.nav-card {
  min-height: 144rpx;
  padding: 22rpx;
  border: 1rpx solid #1c2d46;
  border-radius: 14rpx;
  background: #0e1b2e;
}

.nav-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.nav-meta {
  margin-top: 10rpx;
  display: block;
  color: #8ea5c4;
  font-size: 22rpx;
}

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #8ea5c4;
}

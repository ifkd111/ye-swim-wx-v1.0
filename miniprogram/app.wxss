page {
  --color-brand: #23836f;
  --color-brand-dark: #176f63;
  --color-brand-soft: #eaf5f2;
  --color-warning: #ffc107;
  --color-danger: #c81e1e;
  --color-text: #33423d;
  --color-text-strong: #182420;
  --color-text-muted: #74807a;
  --color-border: #e2e7e3;
  --radius-button: 18rpx;
  --radius-card: 22rpx;
  --space-xs: 10rpx;
  --space-base: 20rpx;
  --space-md: 30rpx;
  --space-lg: 40rpx;
  min-height: 100vh;
  background: #f2f4f0;
  color: var(--color-text-strong);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  background: #f2f4f0;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.topbar > view:first-child {
  min-width: 0;
  flex: 1;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  max-width: 100%;
  justify-content: flex-start;
  flex-wrap: wrap;
}

.title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #182420;
  word-break: keep-all;
  white-space: normal;
}

.subtitle {
  margin-top: 8rpx;
  color: #74807a;
  font-size: 24rpx;
  line-height: 1.45;
}

.card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: var(--space-base);
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(28, 51, 43, 0.055);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #182420;
  margin-bottom: 14rpx;
}

.link-text {
  color: var(--color-brand);
  font-size: 24rpx;
  font-weight: 800;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric {
  width: calc((100% - 16rpx) / 2);
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--color-brand-soft);
  border: 1rpx solid #d5e7fb;
  min-height: 144rpx;
}

.tappable {
  transition: opacity 0.12s ease, transform 0.12s ease;
}

.tappable:active,
.nav-card:active,
.list-item:active {
  opacity: 0.78;
  transform: scale(0.99);
}

.metric-value {
  display: block;
  color: var(--color-brand-dark);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.metric-label {
  margin-top: 6rpx;
  display: block;
  color: #46627f;
  font-size: 23rpx;
  line-height: 1.35;
}

.metric-action {
  margin-top: 8rpx;
  display: block;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 700;
}

.list-item {
  padding: 20rpx 0;
  border-top: 1rpx solid #e1ebf8;
}

.list-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.row > view:first-child {
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text-strong);
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 90rpx;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e9f8ef;
  color: #137a3d;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.badge.warn {
  background: #fff5d9;
  color: #a06500;
}

.badge.danger {
  background: #ffe8e8;
  color: #c81e1e;
}

.toolbar {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

button {
  margin: 0;
  min-height: 76rpx;
  border-radius: var(--radius-button);
  padding: 0 28rpx;
  border: 1rpx solid #d6dfda;
  background: #eef2ef;
  color: #294239;
  font-weight: 800;
  font-size: 26rpx;
  line-height: 76rpx;
}

button.primary {
  background: var(--color-brand-dark);
  border-color: var(--color-brand-dark);
  color: #ffffff;
}

button.mini {
  min-height: 62rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  line-height: 62rpx;
  min-width: 150rpx;
}

button.danger {
  background: #fff0f0;
  border-color: #ffb4b4;
  color: #c81e1e;
}

button[disabled] {
  opacity: 0.55;
}

input,
textarea {
  width: 100%;
  min-height: 78rpx;
  border-radius: 14rpx;
  padding: 0 22rpx;
  color: var(--color-text-strong);
  background: #f8fbff;
  border: 1rpx solid #c9dbf2;
}

textarea {
  min-height: 130rpx;
  padding-top: 18rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #365a84;
  font-size: 24rpx;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.form-grid .field {
  width: calc((100% - 16rpx) / 2);
  margin-bottom: 0;
}

.nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.nav-card {
  width: calc((100% - 16rpx) / 2);
  min-height: 144rpx;
  padding: 22rpx;
  border: 1rpx solid #d5e7fb;
  border-radius: 18rpx;
  background: #f8fbff;
}

.nav-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #12325b;
}

.nav-meta {
  margin-top: 10rpx;
  display: block;
  color: #5d7292;
  font-size: 22rpx;
}

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #7a8da8;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef6ff;
  border: 1rpx solid #d5e7fb;
  color: #12325b;
  font-size: 24rpx;
  font-weight: 800;
}

.chip.active {
  background: var(--color-brand-dark);
  border-color: var(--color-brand-dark);
  color: #ffffff;
}

.wide-action,
.booking-button,
.confirm-button {
  width: 100%;
  margin-top: 18rpx;
}

.right-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

@media (max-width: 360px) {
  .page {
    padding: 22rpx;
  }

  .top-actions {
    width: 100%;
  }

  .topbar {
    flex-direction: column;
  }

  .title {
    font-size: 38rpx;
  }

  .metric,
  .form-grid .field,
  .nav-card {
    width: 100%;
  }
}


.hero-card {
  border-color: #b9d8ff;
  background: linear-gradient(180deg, #ffffff 0%, #f4f9ff 100%);
}

.text-danger {
  color: #c81e1e !important;
}

.text-warn {
  color: #a06500 !important;
}

.picker-box {
  width: 100%;
  min-height: 78rpx;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  color: var(--color-text-strong);
  background: #f8fbff;
  border: 1rpx solid #c9dbf2;
}

.recommend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e1ebf8;
}

.recommend:first-child {
  border-top: 0;
  padding-top: 0;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(16, 35, 63, 0.42);
}

.modal-card {
  width: 100%;
  max-width: 620rpx;
  padding: 32rpx;
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(16, 35, 63, 0.2);
  text-align: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-strong);
}

.modal-meta {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.status-filter {
  margin: 16rpx 0;
}

/* V1.4 role-first interface */
.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 4rpx 2rpx 26rpx;
}

.eyebrow {
  margin-bottom: 6rpx;
  color: #718079;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e7e3;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(28, 51, 43, .055);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.section-head > view:first-child {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: #182420;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 850;
}

.section-note {
  margin-top: 5rpx;
  color: #7c8781;
  font-size: 21rpx;
  line-height: 1.4;
}

.text-link {
  color: #176f63;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 82rpx;
  padding: 8rpx 13rpx;
  border-radius: 12rpx;
  background: #e8f4ef;
  color: #176f63;
  font-size: 19rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status.warn {
  background: #fff2d9;
  color: #9b6511;
}

.status.muted {
  background: #eef0ee;
  color: #7c8581;
}

.calm-empty {
  padding: 36rpx 12rpx;
  color: #87918c;
  text-align: center;
  font-size: 22rpx;
}

button.block-button {
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
}

button.block-button.quiet {
  background: #f1f3f1;
  border-color: #e1e5e2;
  color: #5e6c66;
}

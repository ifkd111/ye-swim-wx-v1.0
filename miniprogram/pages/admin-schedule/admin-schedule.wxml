<view class="page">
  <view class="topbar">
    <view>
      <view class="title">排课</view>
      <view class="subtitle">老板可手动创建任意日期课程</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">手动排课</view>
    <view class="field">
      <text class="field-label">日期</text>
      <input value="{{form.lessonDate}}" placeholder="2026-06-02" bindinput="input" data-field="lessonDate" />
    </view>
    <view class="field">
      <text class="field-label">时间</text>
      <input value="{{form.lessonTime}}" placeholder="17:00-18:00" bindinput="input" data-field="lessonTime" />
    </view>
    <view class="field">
      <text class="field-label">校区</text>
      <input value="{{form.campus}}" placeholder="绿洲" bindinput="input" data-field="campus" />
    </view>
    <view class="field">
      <text class="field-label">教练</text>
      <input value="{{form.coach}}" placeholder="绿洲教练" bindinput="input" data-field="coach" />
    </view>
    <view class="field">
      <text class="field-label">学员姓名</text>
      <input value="{{form.memberName}}" placeholder="白卓可" bindinput="input" data-field="memberName" />
    </view>
    <button class="primary" bindtap="create">创建排课</button>
  </view>

  <view class="card">
    <view class="card-title">近期排课</view>
    <block wx:if="{{schedules.length}}">
      <view class="list-item" wx:for="{{schedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}} · {{item.coach}}</view>
          </view>
          <text class="badge {{item.lessonStatus === 'completed' ? '' : item.lessonStatus === 'cancelled' ? 'danger' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : item.lessonStatus === 'cancelled' ? '已取消' : '待上课'}}</text>
        </view>
        <button wx:if="{{item.lessonStatus !== 'completed' && item.lessonStatus !== 'cancelled'}}" class="mini danger" data-id="{{item.id}}" bindtap="cancel">取消排课</button>
      </view>
    </block>
    <view wx:else class="empty">暂无排课</view>
  </view>
</view>

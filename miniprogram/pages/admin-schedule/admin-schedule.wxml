<view class="page">
  <view class="topbar"><view><view class="title">课程账</view><view class="subtitle">看课程、扫码核销、必要时补录</view></view></view>

  <view class="card">
    <view class="row card-head">
      <view><view class="card-title">课程</view><view class="meta">学员选课后自动进这里</view></view>
      <button class="primary mini" bindtap="scanVerify">扫码核销</button>
    </view>
    <view class="chip-list status-filter">
      <view class="chip {{filter === 'today' ? 'active' : ''}}" bindtap="setFilter" data-filter="today">今天 {{stats.today}}</view>
      <view class="chip {{filter === 'pending' ? 'active' : ''}}" bindtap="setFilter" data-filter="pending">待上课 {{stats.pending}}</view>
      <view class="chip {{filter === 'completed' ? 'active' : ''}}" bindtap="setFilter" data-filter="completed">已完成 {{stats.completed}}</view>
      <view class="chip {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部 {{stats.all}}</view>
    </view>
    <block wx:if="{{visibleSchedules.length}}"><view class="list-item" wx:for="{{visibleSchedules}}" wx:key="id"><view class="row"><view><view class="name">{{item.memberName}}</view><view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}} · {{item.coach}}</view><view class="meta">{{item.verificationStatusText}} · {{item.verificationPayload}}</view></view><text class="badge {{item.statusClass}}">{{item.statusText}}</text></view><button wx:if="{{item.lessonStatus !== 'completed' && item.lessonStatus !== 'cancelled'}}" class="mini danger" data-id="{{item.id}}" bindtap="cancel">取消排课</button></view></block>
    <view wx:else class="empty">暂无排课</view>
  </view>

  <view class="card">
    <view class="card-title">补录课程</view>
    <view class="meta">只在临时加课、线下已约但系统没记录时使用。</view>
    <view class="field"><text class="field-label">日期</text><input value="{{form.lessonDate}}" placeholder="2026-07-08" bindinput="input" data-field="lessonDate" /></view>
    <view class="field"><text class="field-label">时间</text><input value="{{form.lessonTime}}" placeholder="17:00-18:00" bindinput="input" data-field="lessonTime" /></view>
    <view class="field"><text class="field-label">学员</text><picker mode="selector" range="{{memberNames}}" bindchange="pickMember"><view class="picker-box">{{form.memberName || '请选择学员'}}</view></picker></view>
    <view class="field"><text class="field-label">校区</text><picker mode="selector" range="{{campuses}}" bindchange="pickCampus"><view class="picker-box">{{form.campus || '请选择校区'}}</view></picker></view>
    <view class="field"><text class="field-label">教练</text><picker mode="selector" range="{{coaches}}" bindchange="pickCoach"><view class="picker-box">{{form.coach || '请选择教练'}}</view></picker></view>
    <button bindtap="create">补录课程</button>
  </view>

  <view class="modal-mask" wx:if="{{feedbackVisible}}" bindtap="hideFeedback">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">课后反馈</view>
      <view class="modal-meta">选择标签或写一句成长记录</view>
      <view class="chip-list status-filter">
        <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{feedbackOptions}}" wx:key="label" data-tag="{{item.label}}" bindtap="toggleFeedbackTag">{{item.label}}</view>
      </view>
      <view class="field"><textarea value="{{feedbackNote}}" placeholder="例如：今天动作稳定，继续保持节奏" bindinput="feedbackNoteInput" /></view>
      <view class="toolbar">
        <button bindtap="hideFeedback">稍后</button>
        <button class="primary" bindtap="submitFeedback">保存反馈</button>
      </view>
    </view>
  </view>
</view>

<view class="page">
  <view class="topbar">
    <view>
      <view class="title">账号</view>
      <view class="subtitle">admin / jl / xy 统一登录口</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{accounts.length}}">
      <view class="list-item" wx:for="{{accounts}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.account}}</view>
            <view class="meta">{{roleText[item.role]}} · {{item.fullName || item.coachName || item.memberId}}</view>
            <view class="meta" wx:if="{{item.openid}}">已绑定微信</view>
          </view>
          <text class="badge">{{item.status === 'disabled' ? '停用' : '启用'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无账号</view>
  </view>
</view>

.card button {
  width: 100%;
}

.chip-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.chip {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 0 20rpx;
  background: #13223a;
  border: 1rpx solid #243953;
  color: #f8fbff;
  font-weight: 800;
  font-size: 24rpx;
}

.chip:active {
  opacity: 0.78;
}

.card-head {
  margin-bottom: 8rpx;
}

.card-head button.mini {
  width: auto;
  flex-shrink: 0;
}

.list-item button.mini {
  width: auto;
}

.utility-button {
  margin-top: 16rpx;
}

.template-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #17263d;
}

.template-row:first-child {
  border-top: 0;
  padding-top: 0;
}

.template-fields {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 12rpx;
}

.template-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.template-actions button,
.add-template button {
  width: 100%;
}

.add-template {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 140rpx;
  gap: 12rpx;
  align-items: center;
}

.card button {
  width: 100%;
}

.chip-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.chip {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 0 20rpx;
  background: #13223a;
  border: 1rpx solid #243953;
  color: #f8fbff;
  font-weight: 800;
  font-size: 24rpx;
}

.chip:active {
  opacity: 0.78;
}

.card-head {
  margin-bottom: 8rpx;
}

.list-item button.mini {
  width: auto;
}

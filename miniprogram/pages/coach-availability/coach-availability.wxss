.card button {
  width: 100%;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  width: calc((100% - 14rpx) / 2);
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 0 20rpx;
  background: #eef6ff;
  border: 1rpx solid #d5e7fb;
  color: #12325b;
  font-weight: 800;
  font-size: 24rpx;
}

.chip:active {
  opacity: 0.78;
}

.card-head {
  margin-bottom: 8rpx;
}

.card-head button.mini {
  width: auto;
  flex-shrink: 0;
}

.list-item button.mini {
  width: auto;
}

.utility-button {
  margin-top: 16rpx;
}

.template-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #e1ebf8;
}

.template-row:first-child {
  border-top: 0;
  padding-top: 0;
}

.template-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.template-fields input:first-child {
  width: 180rpx;
}

.template-fields input:last-child {
  flex: 1;
  min-width: 260rpx;
}

.template-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.template-actions button,
.add-template button {
  flex: 1;
}

.add-template {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-template .template-fields {
  flex: 1;
}

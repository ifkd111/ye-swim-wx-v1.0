<view class="page">
  <view class="topbar">
    <view>
      <view class="title">空余助手</view>
      <view class="subtitle">说一句话或点快捷按钮，先预览再提交</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">一句话生成</view>
    <textarea value="{{phrase}}" placeholder="比如：明天下午有空&#10;下周每天下午有空&#10;每周几几点到几点可以上课" bindinput="phraseInput" />
    <view class="toolbar">
      <button class="primary" bindtap="parsePhrase">生成预览</button>
      <button bindtap="clearPreview">清空</button>
    </view>
  </view>

  <view class="card">
    <view class="row card-head">
      <view>
        <view class="card-title">常用模板</view>
        <view class="meta">每个教练可按自己的习惯修改</view>
      </view>
      <button class="mini" bindtap="toggleTemplateEdit">{{templateEditing ? '完成' : '编辑'}}</button>
    </view>
    <block wx:if="{{!templateEditing}}">
      <view class="chip-list">
        <view class="chip" wx:for="{{templates}}" wx:key="id" bindtap="applyTemplate" data-index="{{index}}">{{item.label}}</view>
      </view>
      <button class="utility-button" bindtap="copyWeek">复制本周到下周</button>
    </block>
    <block wx:else>
      <view class="template-row" wx:for="{{templates}}" wx:key="id">
        <view class="template-fields">
          <input value="{{item.label}}" placeholder="按钮名" bindinput="templateInput" data-index="{{index}}" data-field="label" />
          <input value="{{item.phrase}}" placeholder="例如：明天下午有空" bindinput="templateInput" data-index="{{index}}" data-field="phrase" />
        </view>
        <view class="template-actions">
          <button class="mini primary" bindtap="applyTemplate" data-index="{{index}}">试用</button>
          <button class="mini danger" bindtap="removeTemplate" data-index="{{index}}">删除</button>
        </view>
      </view>
      <view class="template-row add-template">
        <view class="template-fields">
          <input value="{{newTemplate.label}}" placeholder="新按钮名" bindinput="newTemplateInput" data-field="label" />
          <input value="{{newTemplate.phrase}}" placeholder="一句话规则" bindinput="newTemplateInput" data-field="phrase" />
        </view>
        <button class="mini primary" bindtap="addTemplate">添加</button>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="card-title">记忆设置</view>
    <view class="form-grid">
      <view class="field">
        <text class="field-label">默认校区</text>
        <input value="{{settings.campus}}" placeholder="绿洲" bindinput="settingInput" data-field="campus" />
      </view>
      <view class="field">
        <text class="field-label">默认名额</text>
        <input type="number" value="{{settings.capacity}}" bindinput="settingInput" data-field="capacity" />
      </view>
      <view class="field">
        <text class="field-label">每节课分钟</text>
        <input type="number" value="{{settings.lessonMinutes}}" bindinput="settingInput" data-field="lessonMinutes" />
      </view>
      <view class="field">
        <text class="field-label">每周重复几周</text>
        <input type="number" value="{{settings.repeatWeeks}}" bindinput="settingInput" data-field="repeatWeeks" />
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{previewSlots.length}}">
    <view class="row card-head">
      <view class="card-title">预览 {{previewSlots.length}} 个</view>
      <button class="primary mini" bindtap="submitPreview">提交</button>
    </view>
    <view class="list-item" wx:for="{{previewSlots}}" wx:key="index">
      <view class="row">
        <view>
          <view class="name">{{item.slotDate}} {{item.slotTime}}</view>
          <view class="meta">{{item.campus}} · 名额 {{item.capacity}}</view>
        </view>
        <button class="mini" data-index="{{index}}" catchtap="removePreview">移除</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">手动补一条</view>
    <view class="field">
      <text class="field-label">日期</text>
      <input value="{{form.slotDate}}" placeholder="2026-06-02" bindinput="input" data-field="slotDate" />
    </view>
    <view class="field">
      <text class="field-label">时间</text>
      <input value="{{form.slotTime}}" placeholder="17:00-18:00" bindinput="input" data-field="slotTime" />
    </view>
    <view class="field">
      <text class="field-label">校区</text>
      <input value="{{form.campus}}" placeholder="绿洲" bindinput="input" data-field="campus" />
    </view>
    <button class="primary" bindtap="create">提交</button>
  </view>

  <view class="card">
    <view class="card-title">我的空余时间</view>
    <block wx:if="{{slots.length}}">
      <view class="list-item" wx:for="{{slots}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.slotDate}} {{item.slotTime}}</view>
            <view class="meta">{{item.campus}} · 名额 {{item.capacity}}</view>
          </view>
          <text class="badge {{item.status === 'published' ? '' : 'warn'}}">{{item.status === 'published' ? '已发布' : '草稿'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无空余时间</view>
  </view>
</view>

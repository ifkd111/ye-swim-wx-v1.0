.demo-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.demo-hero{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:12rpx 2rpx 24rpx}.demo-brand{font-size:52rpx;font-weight:950;letter-spacing:6rpx;color:#153f39}.demo-tagline{margin-top:4rpx;color:#64736c;font-size:21rpx}.login-entry{min-height:72rpx;padding:0 22rpx;border-color:#bfd3ca;background:#fff;color:#176f63;font-size:22rpx;line-height:72rpx}.privacy-note{display:flex;align-items:flex-start;gap:16rpx;margin-bottom:20rpx;padding:18rpx 20rpx;border:1rpx solid #cfe2d9;border-radius:20rpx;background:#edf7f3;color:#496058;font-size:21rpx;line-height:1.5}.privacy-note>text{flex-shrink:0;padding:5rpx 10rpx;border-radius:10rpx;background:#176f63;color:#fff;font-size:18rpx;font-weight:900}.demo-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-bottom:18rpx;padding:7rpx;border-radius:20rpx;background:#e8eae6}.demo-tab{min-height:82rpx;padding:0 10rpx;border:0;border-radius:15rpx;background:transparent;color:#5a6862;font-size:21rpx;line-height:1.25}.demo-tab.active{background:#fff;color:#16483d;box-shadow:0 5rpx 16rpx rgba(37,56,48,.1)}.demo-panel{padding:24rpx;border:1rpx solid #e0e3dd;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(30,53,44,.06)}.coach-strip{margin:-24rpx -24rpx 24rpx;padding:30rpx 28rpx;border-radius:28rpx 28rpx 0 0;background:#153f39;color:#fff}.coach-strip .eyebrow{color:rgba(255,255,255,.72)}.demo-coach{font-size:42rpx;font-weight:950}.coach-meta{margin-top:7rpx;color:rgba(255,255,255,.76);font-size:21rpx}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-bottom:18rpx}.demo-member{overflow:hidden;margin-top:14rpx;border:2rpx solid #dfe6e2;border-radius:20rpx;transition:border-color .2s ease,background-color .2s ease}.demo-member.active{border-color:#4f9f91;background:#f3faf7}.member-head{min-height:92rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx}.member-name{font-size:27rpx;font-weight:900}.member-meta{margin-top:6rpx;color:#66756e;font-size:21rpx}.arrival{flex-shrink:0;padding:11rpx 15rpx;border-radius:999rpx;background:#edf0ee;color:#66736d;font-size:19rpx;font-weight:850}.arrival.active{background:#dcefe8;color:#176f63}.member-count{display:flex;align-items:center;gap:14rpx;padding:0 20rpx 20rpx;color:#52625b;font-size:20rpx;font-weight:800}.member-count>text{flex-shrink:0}.count-options{flex:1;display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx}.count-button{min-width:0;min-height:76rpx;padding:0;border-radius:16rpx;background:#fff;font-size:23rpx;line-height:76rpx}.count-button.active{border-color:#176f63;background:#176f63;color:#fff}.demo-summary{margin:22rpx 0 10rpx;color:#43534c;text-align:center;font-size:23rpx;font-weight:800}.demo-confirm{width:100%;min-height:86rpx;line-height:86rpx}.receipt-panel{text-align:center}.success-ring{width:108rpx;height:108rpx;margin:18rpx auto;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#176f63;color:#fff;font-size:25rpx;font-weight:950}.success-title{font-size:38rpx;font-weight:950}.success-note{margin:8rpx 0 24rpx;color:#64736c;font-size:21rpx}.receipt-row,.owner-log{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:19rpx 0;border-top:1rpx solid #e8ece9;text-align:left}.receipt-balance,.log-lessons{color:#176f63;font-size:25rpx;font-weight:950}.code-stage{display:flex;justify-content:center;padding:28rpx 0}.code-frame{position:relative;width:300rpx;height:300rpx;display:flex;align-items:center;justify-content:center;border:14rpx solid #17241f;border-radius:30rpx;background:repeating-linear-gradient(45deg,#fff 0,#fff 12rpx,#17241f 13rpx,#17241f 23rpx,#fff 24rpx,#fff 34rpx)}.code-leaf{position:relative;z-index:2;width:100rpx;height:100rpx;display:flex;align-items:center;justify-content:center;border:10rpx solid #fff;border-radius:30rpx;background:#176f63;color:#fff;font-size:42rpx;font-weight:950}.code-corner{position:absolute;z-index:2;width:52rpx;height:52rpx;border:12rpx solid #17241f;background:#fff}.code-corner.tl{left:14rpx;top:14rpx}.code-corner.tr{right:14rpx;top:14rpx}.code-corner.bl{left:14rpx;bottom:14rpx}.code-corner.br{right:14rpx;bottom:14rpx}.coach-facts>view{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-top:1rpx solid #e6ebe8;color:#66756e;font-size:22rpx}.coach-facts>view>text:last-child{color:#243b32;font-weight:850}.owner-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-bottom:12rpx}.owner-metrics>view{padding:20rpx 8rpx;border-radius:18rpx;background:#edf7f3;text-align:center}.owner-metrics text{display:block}.owner-metrics text:first-child{color:#176f63;font-size:38rpx;font-weight:950}.owner-metrics text:last-child{margin-top:5rpx;color:#5b6a63;font-size:19rpx}.login-after-demo{margin-top:20rpx;padding:24rpx;border:1rpx solid #e0e3dd;border-radius:26rpx;background:rgba(255,255,255,.94);text-align:center}.login-after-demo button{width:100%;margin-top:18rpx}.login-after-demo .section-note{font-size:20rpx}

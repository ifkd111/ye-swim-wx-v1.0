<view class="page admin-page">
  <view class="app-header"><view><view class="eyebrow">今日消课</view><view class="title">{{viewer.fullName || '老板'}}</view></view><view class="my-code" bindtap="previewCode">我的今日教练码</view></view>
  <view class="owner-code-card" wx:if="{{code.fileId}}" bindtap="previewCode"><image src="{{code.fileId}}" mode="aspectFit"></image><view><view class="owner-code-title">我的今日教练码</view><view class="owner-code-note">老板带课时，让家长直接扫码 · 点击放大</view></view><text>›</text></view>
  <view class="owner-code-card code-error" wx:else><view><view class="owner-code-title">今日教练码暂未生成</view><view class="owner-code-note">下拉刷新后重试</view></view></view>
  <view class="stats"><view><text>{{stats.todayStudents || 0}}</text><text>今日学员</text></view><view><text>{{stats.todayLessons || 0}}</text><text>今日消课</text></view><view class="{{stats.debtMembers ? 'danger' : ''}}"><text>{{stats.debtMembers || 0}}</text><text>欠课学员</text></view></view>
  <view class="quick-actions"><view bindtap="goCoaches"><text class="action-icon">教</text><text class="action-title">教练</text><text class="action-note">人员与每日码</text></view><view bindtap="goMembers"><text class="action-icon">课</text><text class="action-title">学员课时</text><text class="action-note">绑定家长与加课</text></view><view bindtap="openManual"><text class="action-icon">补</text><text class="action-title">补录消课</text><text class="action-note">漏扫或少扣时使用</text></view></view>
  <view class="section"><view class="section-head"><view><view class="section-title">今天的流水</view><view class="section-note">点击记录可以修改或撤销</view></view></view><view class="log-row" wx:for="{{todayLogs}}" wx:key="id" data-id="{{item.id}}" bindtap="manageLog"><view class="log-time">{{item.attendanceTime || '--:--'}}</view><view class="log-main"><view class="log-name">{{item.coach}} · {{item.memberName}}</view><view class="meta">{{item.source === 'admin_manual' ? '老板补录' : '家长扫码'}}</view></view><text class="lessons">{{item.lessonsDeducted}} 节 ›</text></view><view wx:if="{{!todayLogs.length}}" class="empty">今天还没有消课记录</view></view>
  <view class="logout" bindtap="logout">退出登录</view>
  <view class="modal-mask" wx:if="{{manualVisible}}" bindtap="closeManual"><view class="modal-card manual-card" catchtap="noop"><view class="modal-title">补录消课</view><view class="field-label">教练</view><view class="chips"><view class="chip {{selectedCoach === item.account ? 'active' : ''}}" wx:for="{{accounts}}" wx:key="account" data-account="{{item.account}}" bindtap="selectCoach">{{item.coachName || item.fullName}}</view></view><view class="field-label">学员</view><view class="chips"><view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{manualMembers}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleManualMember">{{item.chineseName}}</view></view><view class="field-label">每人扣除</view><view class="chips"><view class="chip {{manualLessons === item ? 'active' : ''}}" wx:for="{{lessonOptions}}" wx:key="*this" data-value="{{item}}" bindtap="selectManualLessons">{{item}} 节</view></view><view class="field"><text class="field-label">其他课时数</text><input type="number" value="{{manualLessons}}" placeholder="可输入 1 至 99" data-field="manualLessons" bindinput="manualInput" /></view><view class="field"><text class="field-label">日期</text><input value="{{manualDate}}" data-field="manualDate" bindinput="manualInput" /></view><view class="field"><text class="field-label">时间</text><input value="{{manualTime}}" data-field="manualTime" bindinput="manualInput" /></view><view class="field"><text class="field-label">补录原因</text><input value="{{manualReason}}" data-field="manualReason" bindinput="manualInput" /></view><button class="primary wide-action" loading="{{saving}}" bindtap="submitManual">确认补录</button></view></view>
</view>

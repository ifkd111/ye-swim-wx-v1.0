.admin-page{padding-bottom:80rpx}.my-code{max-width:204rpx;padding:14rpx 18rpx;border-radius:18rpx;background:#e7efe9;color:#16483d;text-align:center;font-size:21rpx;font-weight:900}.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:18rpx;padding:27rpx 10rpx;border:1rpx solid #e4e3dc;border-radius:26rpx;background:rgba(255,255,255,.94);box-shadow:0 10rpx 28rpx rgba(42,54,48,.05);text-align:center}.stats>view+view{border-left:1rpx solid #e8e7e0}.stats text{display:block}.stats text:first-child{font-size:42rpx;font-weight:900;color:#1f6254}.stats text:last-child{margin-top:6rpx;color:#7a8781;font-size:20rpx}.stats .danger text:first-child{color:#b95343}.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx;margin:16rpx 0 20rpx}.quick-actions>view{min-width:0;min-height:174rpx;padding:20rpx 18rpx 22rpx;border:1rpx solid #e5e3dc;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(44,57,51,.045)}.quick-actions text{display:block}.action-icon{width:50rpx;height:50rpx;display:flex!important;align-items:center;justify-content:center;margin-bottom:18rpx;border-radius:16rpx;background:#e5f0eb;color:#1d5b4d;font-size:21rpx;font-weight:900}.quick-actions>view:first-child .action-icon{background:#174d41;color:#fff}.quick-actions>view:nth-child(2) .action-icon{background:#e5f0eb;color:#1d5b4d}.quick-actions>view:nth-child(3) .action-icon{background:#f2e9d9;color:#8a6734}.quick-actions>view:nth-child(4) .action-icon{background:#eee8e1;color:#725b47}.action-title{font-size:25rpx;font-weight:900}.action-note{margin-top:7rpx;color:#7b8781;font-size:19rpx;line-height:1.45}.log-row{display:grid;grid-template-columns:82rpx 1fr auto;align-items:center;gap:14rpx;padding:22rpx 0;border-top:1rpx solid #ebe9e2}.log-time{font-weight:900;color:#276859}.log-name{font-size:26rpx;font-weight:900}.meta{margin-top:5rpx;color:#7b8781;font-size:21rpx}.lessons{font-weight:900}.empty{padding:42rpx 0;text-align:center;color:#8a948f}.logout{padding:30rpx;text-align:center;color:#7a8781;font-size:23rpx}.manual-card{max-height:82vh;overflow-y:auto}.field-label{display:block;margin:22rpx 0 10rpx;color:#65736c;font-size:22rpx;font-weight:800}.chips{display:flex;flex-wrap:wrap;gap:10rpx}.chip{padding:13rpx 17rpx;border-radius:14rpx;background:#f0f3f1;color:#56645d;font-size:22rpx}.chip.active{background:#176f63;color:#fff}
.owner-code-card{position:relative;display:flex;align-items:center;gap:22rpx;overflow:hidden;padding:22rpx 24rpx;border-radius:28rpx;background:linear-gradient(135deg,#174d41 0%,#103a31 100%);color:#fff;box-shadow:0 18rpx 38rpx rgba(20,65,55,.2)}.owner-code-card::after{content:"";position:absolute;width:180rpx;height:180rpx;right:-80rpx;top:-90rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:50%}.owner-code-card image{width:112rpx;height:112rpx;border:8rpx solid #fff;border-radius:17rpx;background:#fff}.owner-code-card>view{min-width:0;flex:1}.owner-code-card>text{font-size:42rpx}.owner-code-title{font-size:28rpx;font-weight:900}.owner-code-note{margin-top:7rpx;color:rgba(255,255,255,.7);font-size:20rpx}.owner-code-card.code-error{background:#fff;color:#263b34;box-shadow:none}.code-error .owner-code-note{color:#7b8781}

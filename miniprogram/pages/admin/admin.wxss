.admin-page{padding-bottom:80rpx}.my-code{max-width:200rpx;padding:14rpx 18rpx;border-radius:16rpx;background:#153f39;color:#fff;text-align:center;font-size:22rpx;font-weight:800}.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:22rpx;padding:25rpx 10rpx;border-radius:24rpx;background:#fff;text-align:center}.stats>view+view{border-left:1rpx solid #e5ebe7}.stats text{display:block}.stats text:first-child{font-size:40rpx;font-weight:900;color:#176f63}.stats text:last-child{margin-top:6rpx;color:#7a8781;font-size:21rpx}.stats .danger text:first-child{color:#c64d3d}.quick-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:16rpx 0}.quick-actions>view{padding:22rpx 15rpx;border-radius:20rpx;background:#fff}.quick-actions text{display:block}.quick-actions text:first-child{font-size:26rpx;font-weight:850}.quick-actions text:last-child{margin-top:7rpx;color:#7b8781;font-size:19rpx}.log-row{display:grid;grid-template-columns:82rpx 1fr auto;align-items:center;gap:14rpx;padding:20rpx 0;border-top:1rpx solid #e8ece9}.log-time{font-weight:850;color:#176f63}.log-name{font-size:26rpx;font-weight:850}.meta{margin-top:5rpx;color:#7b8781;font-size:21rpx}.lessons{font-weight:900}.empty{padding:42rpx 0;text-align:center;color:#8a948f}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:23rpx}.manual-card{max-height:82vh;overflow-y:auto}.field-label{display:block;margin:22rpx 0 10rpx;color:#65736c;font-size:22rpx;font-weight:800}.chips{display:flex;flex-wrap:wrap;gap:10rpx}.chip{padding:13rpx 17rpx;border-radius:14rpx;background:#f0f3f1;color:#56645d;font-size:22rpx}.chip.active{background:#176f63;color:#fff}
.owner-code-card{display:flex;align-items:center;gap:20rpx;padding:18rpx 22rpx;border-radius:22rpx;background:#153f39;color:#fff}.owner-code-card image{width:104rpx;height:104rpx;border-radius:12rpx;background:#fff}.owner-code-card>view{min-width:0;flex:1}.owner-code-card>text{font-size:42rpx}.owner-code-title{font-size:27rpx;font-weight:900}.owner-code-note{margin-top:7rpx;color:rgba(255,255,255,.7);font-size:20rpx}.owner-code-card.code-error{background:#fff;color:#263b34}.code-error .owner-code-note{color:#7b8781}

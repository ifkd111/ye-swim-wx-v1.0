.toolbar button {
  min-width: 180rpx;
}

.recommend {
  min-height: 150rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #d5e7fb;
  border-radius: 16rpx;
  background: #eef6ff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.card button.primary {
  width: 100%;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  min-width: calc((100% - 36rpx) / 4);
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid #d5e7fb;
  background: #eef6ff;
  color: #12325b;
  font-weight: 800;
  font-size: 22rpx;
}

.chip.active {
  background: #1268cf;
  border-color: #1268cf;
  color: #ffffff;
}

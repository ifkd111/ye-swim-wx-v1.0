<view class="page">
  <view class="topbar">
    <view>
      <view class="title">预约课程</view>
      <view class="subtitle">{{ruleText}}</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{slots.length}}">
      <view class="list-item" wx:for="{{slots}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.slotDate}} {{item.slotTime}}</view>
            <view class="meta">{{item.campus}} · {{item.coach}} · 名额 {{item.capacity}}</view>
          </view>
          <text class="badge">可约</text>
        </view>
        <view class="toolbar">
          <button class="primary" data-id="{{item.id}}" bindtap="book">提交预约</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无可预约时间</view>
  </view>

  <view class="card">
    <view class="card-title">我的预约</view>
    <block wx:if="{{bookings.length}}">
      <view class="list-item" wx:for="{{bookings}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.slotDate}} {{item.slotTime}}</view>
            <view class="meta">{{item.coach}} · {{item.campus}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : item.status === 'rejected' ? 'danger' : ''}}">{{statusText[item.status]}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无预约记录</view>
  </view>
</view>

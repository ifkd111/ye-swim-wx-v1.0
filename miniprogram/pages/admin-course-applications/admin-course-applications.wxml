<view class="page">
  <view class="topbar">
    <view>
      <view class="title">课程申请</view>
      <view class="subtitle">处理学员续课、加课申请</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{applications.length}}">
      <view class="list-item" wx:for="{{applications}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">申请：{{item.productName}} · 当前：{{item.currentProductName || '未知'}} / 总 {{item.currentTotalLessons || '-'}} / 剩余 {{item.remainingLessons === undefined ? '-' : item.remainingLessons}}</view>
            <view class="meta" wx:if="{{item.note}}">备注：{{item.note}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : item.status === 'rejected' ? 'danger' : ''}}">{{statusText[item.status]}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.status === 'pending'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="approve">通过</button>
          <button class="danger" data-id="{{item.id}}" bindtap="reject">拒绝</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无课程申请</view>
  </view>
</view>

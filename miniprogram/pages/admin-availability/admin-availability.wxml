<view class="page">
  <view class="topbar">
    <view>
      <view class="title">空余时间</view>
      <view class="subtitle">老板控制哪些教练时间对学员开放</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">发布可预约时间</view>
    <view class="field">
      <text class="field-label">日期</text>
      <input value="{{form.slotDate}}" placeholder="2026-06-02" bindinput="input" data-field="slotDate" />
    </view>
    <view class="field">
      <text class="field-label">时间</text>
      <input value="{{form.slotTime}}" placeholder="17:00-18:00" bindinput="input" data-field="slotTime" />
    </view>
    <view class="field">
      <text class="field-label">校区</text>
      <input value="{{form.campus}}" placeholder="绿洲" bindinput="input" data-field="campus" />
    </view>
    <view class="field">
      <text class="field-label">教练</text>
      <input value="{{form.coach}}" placeholder="绿洲教练" bindinput="input" data-field="coach" />
    </view>
    <view class="field">
      <text class="field-label">名额</text>
      <input type="number" value="{{form.capacity}}" bindinput="input" data-field="capacity" />
    </view>
    <button class="primary" bindtap="create">发布</button>
  </view>

  <view class="card">
    <view class="card-title">已有时间</view>
    <block wx:if="{{slots.length}}">
      <view class="list-item" wx:for="{{slots}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.coach}}</view>
            <view class="meta">{{item.slotDate}} {{item.slotTime}} · {{item.campus}} · 名额 {{item.capacity}}</view>
          </view>
          <text class="badge {{item.status === 'published' ? '' : 'warn'}}">{{item.status === 'published' ? '已发布' : '草稿'}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.status !== 'published'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="publish">发布</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无空余时间</view>
  </view>
</view>

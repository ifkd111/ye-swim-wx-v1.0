.login-page {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 44rpx 34rpx;
  background: linear-gradient(160deg, #123f36 0%, #1d5c4e 38%, #f5f2eb 38.2%, #f5f2eb 100%);
}

.ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-one {
  width: 320rpx;
  height: 320rpx;
  right: -110rpx;
  top: -90rpx;
  border: 1rpx solid rgba(255,255,255,.16);
}

.ambient-two {
  width: 180rpx;
  height: 180rpx;
  left: -80rpx;
  top: 180rpx;
  background: rgba(216, 184, 126, .12);
}

.login-card {
  position: relative;
  z-index: 2;
  width: 100%;
  border: 1rpx solid rgba(255,255,255,.72);
  border-radius: 36rpx;
  padding: 40rpx 34rpx 36rpx;
  background: rgba(255,255,255,.96);
  box-shadow: 0 34rpx 90rpx rgba(17, 47, 40, .2);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 20rpx;
}

.leaf-mark {
  position: relative;
  width: 98rpx;
  height: 98rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(145deg, #367d6d 0%, #16483d 72%, #10362e 100%);
  box-shadow: 0 16rpx 36rpx rgba(22, 72, 61, .24);
}

.leaf-mark::before {
  content: "";
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx 999rpx 999rpx 20rpx;
  transform: rotate(-18deg);
  background: rgba(255, 255, 255, 0.16);
  left: -16rpx;
  top: -12rpx;
}

.leaf-text {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.wave-line {
  position: absolute;
  left: 20rpx;
  right: 18rpx;
  bottom: 24rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d9b87d;
  transform: rotate(-8deg);
}

.brand-copy {
  min-width: 0;
  flex: 1;
}

.brand-copy .title {
  font-size: 48rpx;
  letter-spacing: 5rpx;
}

.brand-note {
  margin-top: 5rpx;
  color: #6f7c75;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.login-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 22rpx;
  line-height: 88rpx;
}

.login-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
  margin: 28rpx 0 24rpx;
  padding: 7rpx;
  border-radius: 20rpx;
  background: #eeeee8;
}

.login-tabs .chip {
  min-height: 66rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 15rpx;
  background: transparent;
  color: #69766f;
  font-size: 23rpx;
}

.login-tabs .chip.active {
  background: #fff;
  color: #16483d;
  box-shadow: 0 5rpx 16rpx rgba(37, 56, 48, .1);
}

.login-tip {
  margin-top: 18rpx;
  color: #748079;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.identity-guide {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfe7e2;
  border-radius: 20rpx;
  background: #f3f7f4;
}

.guide-mark {
  width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #dfeee8;
  color: #236554;
  font-size: 24rpx;
  font-weight: 900;
}

.guide-mark.owner {
  background: #f1e8d8;
  color: #936c34;
}

.guide-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.identity-guide-title {
  color: #23352e;
  font-size: 26rpx;
  font-weight: 900;
}

.identity-guide-text {
  color: #748079;
  font-size: 22rpx;
  line-height: 1.5;
}

.test-panel {
  margin-top: 18rpx;
}

.form-error {
  margin-top: 12rpx;
  padding: 15rpx 18rpx;
  border: 1rpx solid #efd1cb;
  border-radius: 14rpx;
  background: #fff4f1;
  color: #a34538;
  font-size: 22rpx;
  line-height: 1.45;
}

.role-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-grid button {
  flex: 1;
  min-width: 0;
}

.login-help{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:18rpx;background:#edf0ed;color:#5c6b64;font-size:23rpx;font-weight:950}
.login-main{padding-top:18rpx;text-align:center}
.phone-symbol{display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;margin:0 auto 18rpx;border-radius:28rpx;background:#e1eee8;color:#176f63;font-size:31rpx;font-weight:950}
.login-title{font-size:31rpx;font-weight:950}
.account-scope{margin-top:10rpx;color:#66756e;font-size:21rpx;line-height:1.45}
.login-main>.field{margin-top:22rpx;text-align:left}
.account-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;text-align:left}
.account-head>text{padding:12rpx;color:#748079;font-size:21rpx}
.help-lines{margin-top:24rpx;text-align:left}
.help-lines>view{display:grid;grid-template-columns:90rpx 1fr;gap:14rpx;padding:16rpx 0;border-top:1rpx solid #eceae4}
.help-lines>view>text:first-child{color:#176f63;font-weight:900}
.help-lines>view>text:last-child{color:#6f7b75;font-size:22rpx;line-height:1.5}
.recovery-button{width:100%;margin-top:12rpx;background:transparent;border-color:transparent;color:#748079;box-shadow:none;font-size:21rpx}
.guest-return{display:block;width:100%;min-height:80rpx;margin-top:14rpx;border:2rpx solid #d9e2dd;border-radius:16rpx;background:#f5f7f5;color:#315248;font-size:22rpx;line-height:80rpx;text-align:center;box-sizing:border-box}

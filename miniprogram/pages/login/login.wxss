.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: #f4f8ff;
}

.login-card {
  width: 100%;
  border: 1rpx solid #d8e5f7;
  border-radius: 24rpx;
  padding: 44rpx 34rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 90rpx rgba(31, 86, 145, 0.12);
}

.brand-lockup {
  margin-bottom: 30rpx;
}

.leaf-mark {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(145deg, #6bb7ff 0%, #1268cf 62%, #0c438f 100%);
  box-shadow: 0 18rpx 42rpx rgba(18, 104, 207, 0.24);
}

.leaf-mark::before {
  content: "";
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx 999rpx 999rpx 20rpx;
  transform: rotate(-18deg);
  background: rgba(255, 255, 255, 0.16);
  left: -16rpx;
  top: -12rpx;
}

.leaf-text {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.wave-line {
  position: absolute;
  left: 20rpx;
  right: 18rpx;
  bottom: 24rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  transform: rotate(-8deg);
}

.login-button {
  width: 100%;
  margin-top: 22rpx;
}

.login-tabs {
  margin: 28rpx 0 24rpx;
}

.login-tip {
  margin-top: 18rpx;
  color: #5d7292;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.test-panel {
  margin-top: 18rpx;
}

.role-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.role-grid button {
  flex: 1;
  min-width: 0;
}

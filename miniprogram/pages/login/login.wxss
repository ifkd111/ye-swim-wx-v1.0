.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-card {
  width: 100%;
  border: 1rpx solid #1e314d;
  border-radius: 24rpx;
  padding: 44rpx 34rpx;
  background: #0c1728;
  box-shadow: 0 30rpx 90rpx rgba(0, 0, 0, 0.28);
}

.brand-lockup {
  margin-bottom: 30rpx;
}

.leaf-mark {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(145deg, #38f8c7 0%, #13b8b2 52%, #0f7396 100%);
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, 0.28);
}

.leaf-mark::before {
  content: "";
  position: absolute;
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx 999rpx 999rpx 20rpx;
  transform: rotate(-18deg);
  background: rgba(255, 255, 255, 0.16);
  left: -16rpx;
  top: -12rpx;
}

.leaf-text {
  position: relative;
  z-index: 2;
  color: #062523;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.wave-line {
  position: absolute;
  left: 20rpx;
  right: 18rpx;
  bottom: 24rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  transform: rotate(-8deg);
}

.login-button {
  width: 100%;
  margin-top: 22rpx;
}

<view class="page login-page">
  <view class="login-card">
    <view class="brand-lockup">
      <view class="leaf-mark">
        <text class="leaf-text">叶</text>
        <view class="wave-line"></view>
      </view>
    </view>
    <view class="title">叶</view>
    <view class="subtitle">输入账号和密码即可进入对应工作台。</view>

    <view class="field">
      <text class="field-label">账号</text>
      <input value="{{account}}" placeholder="admin / jl001 / xy001" bindinput="onAccountInput" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input password value="{{password}}" placeholder="默认 1324" bindinput="onPasswordInput" />
    </view>

    <button class="primary login-button" loading="{{loading}}" bindtap="login">登录并绑定微信</button>
  </view>
</view>

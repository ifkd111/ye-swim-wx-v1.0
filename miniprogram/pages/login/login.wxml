<view class="page login-page">
  <view class="ambient ambient-one"></view>
  <view class="ambient ambient-two"></view>
  <view class="login-card">
    <view class="brand-row">
      <view class="leaf-mark">
        <text class="leaf-text">叶</text>
        <view class="wave-line"></view>
      </view>
      <view class="brand-copy">
        <view class="title">叶</view>
        <view class="brand-note">每一节课，都清清楚楚</view>
      </view>
    </view>
    <view class="subtitle">老板管理课时，教练展示每日码，家长扫码完成消课。</view>

    <view class="login-tabs">
      <view class="chip {{mode === 'phone' ? 'active' : ''}}" bindtap="setMode" data-mode="phone">手机号登录</view>
      <view class="chip {{mode === 'password' ? 'active' : ''}}" bindtap="setMode" data-mode="password">老板登录</view>
    </view>

    <view wx:if="{{mode === 'phone'}}">
      <view class="identity-guide">
        <view class="guide-mark">微</view>
        <view class="guide-copy"><text class="identity-guide-title">微信手机号一键进入</text><text class="identity-guide-text">验证后自动识别教练或家庭身份</text></view>
      </view>
      <view class="field" wx:if="{{useMock}}">
        <text class="field-label">手机号</text>
        <input value="{{phone}}" type="number" maxlength="11" placeholder="请输入 11 位手机号" bindinput="onPhoneInput" />
      </view>
      <view class="test-panel" wx:if="{{testLogin.enabled}}">
        <view class="login-tip">仅微信开发者工具可用 · {{phone}} · 选择角色直接体验</view>
        <view class="role-grid">
          <button class="primary mini" loading="{{loading}}" data-role="admin" bindtap="testLogin">老板</button>
          <button class="mini" loading="{{loading}}" data-role="coach" bindtap="testLogin">教练</button>
          <button class="mini" loading="{{loading}}" data-role="student" bindtap="testLogin">学员</button>
        </view>
      </view>
      <button wx:if="{{useMock && !testLogin.enabled}}" class="primary login-button" loading="{{loading}}" bindtap="phoneLogin">验证并进入</button>
      <button wx:if="{{!useMock}}" class="primary login-button" loading="{{loading}}" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin">微信验证并进入</button>
      <view class="login-tip" wx:if="{{!testLogin.enabled}}">老板、教练和家长都可使用；首次验证后绑定当前微信。</view>
    </view>

    <view wx:else>
      <view class="identity-guide">
        <view class="guide-mark owner">主</view>
        <view class="guide-copy"><text class="identity-guide-title">老板账号密码登录</text><text class="identity-guide-text">不会绑定，也不会占用当前微信</text></view>
      </view>
      <view class="field">
        <text class="field-label">账号或手机号</text>
        <input value="{{account}}" placeholder="请输入老板账号或老板手机号" bindinput="onAccountInput" />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input password value="{{password}}" placeholder="请输入密码" bindinput="onPasswordInput" />
      </view>
      <button class="primary login-button" loading="{{loading}}" bindtap="login">登录</button>
    </view>
  </view>
</view>

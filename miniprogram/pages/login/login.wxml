<view class="page login-page">
  <view class="ambient ambient-one"></view><view class="ambient ambient-two"></view>
  <view class="login-card">
    <view class="brand-row">
      <view class="leaf-mark"><text class="leaf-text">叶</text><view class="wave-line"></view></view>
      <view class="brand-copy"><view class="title">叶</view><view class="brand-note">每一节课，都清清楚楚</view></view>
      <view class="login-help" bindtap="showHelp">?</view>
    </view>

    <view class="login-main" wx:if="{{mode === 'phone'}}">
      <view class="phone-symbol">微</view><view class="login-title">微信手机号登录</view>
      <view class="test-panel" wx:if="{{testLogin.enabled}}"><view class="role-grid"><button class="mini" loading="{{loading}}" data-role="admin" bindtap="testLogin">老板</button><button class="mini" loading="{{loading}}" data-role="coach" bindtap="testLogin">教练</button><button class="mini" loading="{{loading}}" data-role="student" bindtap="testLogin">学员</button></view></view>
      <button wx:if="{{useMock && !testLogin.enabled}}" class="primary login-button" loading="{{loading}}" bindtap="phoneLogin">微信手机号登录</button>
      <button wx:if="{{!useMock}}" class="primary login-button" loading="{{loading}}" open-type="getPhoneNumber" bindgetphonenumber="phoneLogin">微信手机号登录</button>
      <view class="form-error" wx:if="{{fieldError}}">{{fieldError}}</view>
    </view>

    <view class="login-main account-login" wx:else>
      <view class="account-head"><view class="login-title">账号密码登录</view><text bindtap="closeAccountLogin">关闭</text></view>
      <view class="field"><text class="field-label">账号或手机号</text><input value="{{account}}" maxlength="11" placeholder="请输入账号或手机号" confirm-type="next" bindinput="onAccountInput" /></view>
      <view class="field"><text class="field-label">密码</text><input password value="{{password}}" placeholder="请输入密码" confirm-type="done" bindinput="onPasswordInput" bindconfirm="login" /></view>
      <view class="form-error" wx:if="{{fieldError}}">{{fieldError}}</view>
      <button class="primary login-button" loading="{{loading}}" bindtap="login">登录</button>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{helpVisible}}" bindtap="closeHelp"><view class="modal-card" catchtap="noop"><view class="modal-title">登录说明</view><view class="help-lines"><view><text>自动识别</text><text>验证手机号后，自动进入老板、教练或学员页面</text></view><view><text>家庭账号</text><text>一个手机号可管理名下多名孩子</text></view><view><text>微信资料</text><text>系统不读取真实微信号；头像昵称由用户自愿设置</text></view></view><button class="primary wide-action" bindtap="closeHelp">知道了</button><button class="recovery-button" bindtap="openAccountLogin">账号密码登录</button></view></view>
</view>

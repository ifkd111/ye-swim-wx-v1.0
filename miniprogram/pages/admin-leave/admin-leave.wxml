<view class="page">
  <view class="topbar">
    <view>
      <view class="title">请假补课</view>
      <view class="subtitle">审批学员请假，通过后生成补课额度</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">请假申请</view>
    <block wx:if="{{leaveRequests.length}}">
      <view class="list-item" wx:for="{{leaveRequests}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}} · {{item.coach}}</view>
            <view class="meta">原因：{{item.reason || '未填写'}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : item.status === 'rejected' ? 'danger' : ''}}">{{item.status === 'pending' ? '待审批' : item.status === 'approved' ? '已通过' : '已拒绝'}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.status === 'pending'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="approve">通过</button>
          <button class="danger" data-id="{{item.id}}" bindtap="reject">拒绝</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无请假申请</view>
  </view>

  <view class="card">
    <view class="card-title">补课额度</view>
    <block wx:if="{{makeupCredits.length}}">
      <view class="list-item" wx:for="{{makeupCredits}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.campus}} · {{item.coach}} · {{item.reason || '请假补课'}}</view>
          </view>
          <text class="badge {{item.status === 'available' ? 'warn' : ''}}">{{item.status === 'available' ? '待排课' : '已安排'}}</text>
        </view>
        <view class="makeup-form" wx:if="{{item.status === 'available'}}">
          <view class="form-grid">
            <view class="field"><text class="field-label">日期</text><input value="{{item.lessonDateInput}}" placeholder="2026-07-08" data-id="{{item.id}}" data-field="lessonDateInput" bindinput="inputMakeup" /></view>
            <view class="field"><text class="field-label">时间</text><input value="{{item.lessonTimeInput}}" placeholder="17:00-18:00" data-id="{{item.id}}" data-field="lessonTimeInput" bindinput="inputMakeup" /></view>
            <view class="field"><text class="field-label">校区</text><input value="{{item.campusInput}}" data-id="{{item.id}}" data-field="campusInput" bindinput="inputMakeup" /></view>
            <view class="field"><text class="field-label">教练</text><input value="{{item.coachInput}}" data-id="{{item.id}}" data-field="coachInput" bindinput="inputMakeup" /></view>
          </view>
          <button class="primary wide-action" data-id="{{item.id}}" bindtap="createMakeup">安排补课</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无补课额度</view>
  </view>
</view>

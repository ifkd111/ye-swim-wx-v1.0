<view class="page">
  <view class="topbar">
    <view>
      <view class="title">我的记录</view>
      <view class="subtitle">先看消课，什么时候、哪个教练扣的都在这里</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">上课二维码</view>
    <block wx:if="{{schedules.length}}">
      <view class="list-item" wx:for="{{schedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.dayLabel}} {{item.lessonTime}}</view>
            <view class="meta">{{item.campus}} · {{item.coach}}</view>
            <view class="meta">有效期至 {{item.verificationExpiresAt || '课程后 7 天'}}</view>
          </view>
          <text class="badge {{item.verificationStatusClass}}">{{item.verificationStatusText}}</text>
        </view>
        <button wx:if="{{item.verificationStatus === 'active'}}" class="primary qr-button" data-id="{{item.id}}" bindtap="showQr">查看二维码</button>
        <button wx:if="{{item.lessonStatus === 'pending' && item.diff >= 0}}" class="qr-button" data-id="{{item.id}}" bindtap="requestLeave">申请请假</button>
      </view>
    </block>
    <view wx:else class="empty">暂无可展示课程</view>
  </view>

  <view class="card">
    <view class="card-title">成长反馈</view>
    <block wx:if="{{lessonFeedbacks.length}}">
      <view class="list-item" wx:for="{{lessonFeedbacks}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.lessonDate}} {{item.lessonTime}}</view>
            <view class="meta">{{item.coach}} · {{item.tagsText || '课后反馈'}}</view>
            <view class="meta" wx:if="{{item.note}}">{{item.note}}</view>
          </view>
          <text class="badge">反馈</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无课后反馈</view>
  </view>

  <view class="card">
    <view class="card-title">请假补课</view>
    <block wx:if="{{leaveRequests.length}}">
      <view class="list-item" wx:for="{{leaveRequests}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.lessonDate}} {{item.lessonTime}}</view>
            <view class="meta">{{item.reason || '请假申请'}} · {{item.coach}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : item.status === 'rejected' ? 'danger' : ''}}">{{item.status === 'pending' ? '待审批' : item.status === 'approved' ? '已通过' : '已拒绝'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无请假记录</view>
  </view>

  <view class="card">
    <view class="card-title">消课记录</view>
    <block wx:if="{{attendanceLogs.length}}">
      <view class="list-item" wx:for="{{attendanceLogs}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.attendanceDate}}</view>
            <view class="meta">{{item.coach}} · {{item.campus}} · {{item.sourceNote || '教练确认出勤'}}</view>
          </view>
          <text class="badge">扣 {{item.lessonsDeducted}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无消课记录</view>
  </view>

  <view class="card">
    <view class="card-title">课程申请</view>
    <block wx:if="{{courseApplications.length}}">
      <view class="list-item" wx:for="{{courseApplications}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.productName}}</view>
            <view class="meta">{{item.note || '无备注'}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : item.status === 'rejected' ? 'danger' : ''}}">{{statusText[item.status]}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无课程申请</view>
  </view>

  <view class="modal-mask" wx:if="{{qrVisible}}" bindtap="hideQr">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">课程核销码</view>
      <view class="modal-meta">{{qrSchedule.dayLabel}} {{qrSchedule.lessonTime}}</view>
      <view class="modal-meta">{{qrSchedule.campus}} · {{qrSchedule.coach}}</view>
      <canvas class="qr-canvas" canvas-id="qrCanvas"></canvas>
      <view class="qr-code">{{qrSchedule.verificationPayload}}</view>
      <view class="modal-meta">请出示给教练或老板扫码核销</view>
      <button class="primary" bindtap="hideQr">完成</button>
    </view>
  </view>
</view>

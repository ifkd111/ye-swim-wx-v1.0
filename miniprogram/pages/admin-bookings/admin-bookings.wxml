<view class="page">
  <view class="topbar">
    <view>
      <view class="title">预约审批</view>
      <view class="subtitle">通过后自动生成正式排课</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{bookings.length}}">
      <view class="list-item" wx:for="{{bookings}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.slotDate}} {{item.slotTime}} · {{item.campus}} · {{item.coach}}</view>
            <view class="meta" wx:if="{{item.note}}">备注：{{item.note}}</view>
          </view>
          <text class="badge {{item.status === 'pending' ? 'warn' : ''}}">{{statusText[item.status]}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.status === 'pending'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="approve">通过</button>
          <button class="danger" data-id="{{item.id}}" bindtap="reject">拒绝</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无预约申请</view>
  </view>
</view>

.register-page{padding-bottom:72rpx}.register-hero{display:flex;align-items:center;gap:24rpx;padding:30rpx;border-radius:30rpx;background:linear-gradient(145deg,#174d41,#0f3931);color:#fff;box-shadow:0 18rpx 38rpx rgba(20,65,55,.18)}.code-letter{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:28rpx;background:#d5a84a;color:#173d35;font-size:52rpx;font-weight:950;flex-shrink:0}.hero-copy{min-width:0}.register-hero .eyebrow{color:rgba(255,255,255,.65)}.hero-title{font-size:40rpx;font-weight:950;line-height:1.25}.hero-note{margin-top:8rpx;color:rgba(255,255,255,.72);font-size:21rpx;line-height:1.5}.flow-strip{display:flex;align-items:flex-start;margin:28rpx 8rpx 26rpx}.flow{width:118rpx;color:#8a948f;text-align:center;font-size:19rpx}.flow text{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin:0 auto 8rpx;border-radius:50%;background:#e5e7e3;color:#6f7974;font-size:20rpx;font-weight:900}.flow.active{color:#174d41;font-weight:800}.flow.active text{background:#174d41;color:#fff}.flow-line{height:2rpx;flex:1;margin-top:21rpx;background:#d9dcd7}.coach-panel{padding:30rpx}.privacy-note{display:flex;align-items:center;gap:18rpx;margin-top:28rpx;padding:20rpx;border-radius:20rpx;background:#eef5f1}.privacy-note>text{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:16rpx;background:#d7e9df;color:#174d41;font-weight:900}.privacy-note>view>view:first-child{font-size:24rpx;font-weight:850}.privacy-note>view>view:last-child{margin-top:4rpx;color:#718078;font-size:20rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:4rpx 2rpx 16rpx}.count-badge{padding:8rpx 14rpx;border-radius:999rpx;background:#e9eee9;color:#597068;font-size:20rpx;font-weight:850}.child-card{margin-bottom:16rpx;padding:24rpx;border:1rpx solid #e1e3dc;border-radius:26rpx;background:#fff;box-shadow:0 9rpx 24rpx rgba(42,54,48,.04)}.child-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.child-index{font-size:27rpx;font-weight:900;color:#213a32}.remove-link{display:flex;align-items:center;min-height:88rpx;padding:0 12rpx;color:#a84b40;font-size:21rpx;font-weight:800}.field{display:block;margin-bottom:20rpx}.field:last-child{margin-bottom:0}.field-label{font-weight:800}.field input,.mock-panel input{min-height:88rpx}.field-help{display:block;margin:9rpx 4rpx 0;color:#7b8781;font-size:20rpx}.add-child{width:100%;min-height:88rpx;line-height:88rpx;margin:4rpx 0 24rpx;border-style:dashed;background:#f3f4f0;color:#285f52}.mock-panel{margin:12rpx 0 20rpx;padding:20rpx;border:1rpx dashed #d2a84e;border-radius:20rpx;background:#fff8e8}.form-error{margin-bottom:14rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#fff0ed;color:#9b3c32;font-size:22rpx;line-height:1.5}.submit-button{width:100%;min-height:92rpx;line-height:92rpx;border-radius:24rpx;font-size:29rpx}.submit-help{margin-top:14rpx;color:#76817c;text-align:center;font-size:20rpx}.state-page{display:flex;min-height:72vh;flex-direction:column;align-items:center;justify-content:center;text-align:center}.state-letter{display:flex;align-items:center;justify-content:center;width:112rpx;height:112rpx;border-radius:34rpx;background:#174d41;color:#fff;font-size:52rpx;font-weight:950}.state-letter.muted{background:#dedfd9;color:#66736d}.state-title{margin-top:28rpx;font-size:38rpx;font-weight:950}.state-note{max-width:560rpx;margin-top:12rpx;color:#738079;font-size:24rpx;line-height:1.65}.state-action{min-height:88rpx;margin-top:34rpx;min-width:300rpx}.state-page.success .state-letter{background:#1d715f}@media(min-width:700px){.register-page{max-width:980rpx;margin:0 auto}}

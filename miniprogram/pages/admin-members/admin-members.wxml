<view class="page">
  <block wx:if="{{viewMode === 'list'}}"><view class="app-header"><view><view class="eyebrow">学员与课时</view><view class="title">{{allMembers.length}} 名学员</view></view><button class="primary mini" bindtap="openCreate">新增学员</button></view><view class="search"><input value="{{keyword}}" placeholder="搜索姓名或家长手机号" bindinput="search" /></view><view class="member-card" wx:for="{{members}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><view class="member-head"><view><view class="name">{{item.chineseName}}</view><view class="meta">家长手机 {{item.phone}}</view></view><view class="balance {{item.remainingLessons < 0 ? 'debt' : ''}}">{{item.remainingLessons < 0 ? '欠 ' + (0-item.remainingLessons) : '余 ' + item.remainingLessons}}</view></view><view class="stats"><text>总 {{item.totalLessons}}</text><text>已上 {{item.usedLessons}}</text><text>剩余 {{item.remainingLessons}}</text></view><button class="add-button" data-id="{{item.id}}" catchtap="addLessons">加课 / 调整总课时</button></view><view wx:if="{{!members.length}}" class="empty">暂无学员</view></block>
  <block wx:else><view class="form-header"><text bindtap="closeForm">‹ 返回学员列表</text><view class="title">{{form.id ? '编辑学员' : '新增学员'}}</view><view class="subtitle">同一手机号可以绑定多个孩子</view></view><view class="section"><view class="field"><text class="field-label">学员姓名</text><input value="{{form.chineseName}}" placeholder="请输入姓名" data-field="chineseName" bindinput="input" /></view><view class="field"><text class="field-label">家长手机号</text><input type="number" maxlength="11" disabled="{{form.phoneLocked}}" value="{{form.phone}}" placeholder="用于家长扫码确认" data-field="phone" bindinput="input" /><view wx:if="{{form.phoneLocked}}" class="field-help">此号码已通过微信验证，只可查看，不能修改</view></view><view class="field"><text class="field-label">总课时</text><input type="number" disabled="{{!!form.id}}" value="{{form.totalLessons}}" placeholder="0" data-field="totalLessons" bindinput="input" /><view wx:if="{{form.id}}" class="field-help">已有学员请在列表点击“加课 / 调整总课时”</view></view><view class="field"><text class="field-label">备注</text><input value="{{form.notes}}" placeholder="可选" data-field="notes" bindinput="input" /></view><button class="primary wide-action" loading="{{saving}}" bindtap="save">保存学员</button></view></block>
</view>

<view class="page member-admin-page">
  <block wx:if="{{viewMode === 'list'}}">
    <view class="app-header">
      <view><view class="eyebrow">课时与登录</view><view class="title">学员</view><view class="subtitle">{{filterStats.all}} 位学员 · {{filterStats.low}} 位需要关注</view></view>
      <view class="top-actions"><button class="mini" bindtap="goImport">批量</button><button class="primary mini" bindtap="openCreate">新增</button></view>
    </view>

    <view class="member-summary">
      <view data-filter="all" bindtap="setFilter"><text>{{filterStats.all}}</text><text>全部学员</text></view>
      <view data-filter="low" bindtap="setFilter"><text>{{filterStats.low}}</text><text>低课时</text></view>
      <view data-filter="debt" bindtap="setFilter"><text>{{filterStats.debt}}</text><text>欠课</text></view>
    </view>

    <view class="section member-filter-section">
      <input class="search-input" value="{{keyword}}" placeholder="搜索姓名、手机号、教练或校区" bindinput="search" />
      <view class="member-filter-row">
        <view class="filter-block {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setFilter">全部</view>
        <view class="filter-block {{filter === 'low' ? 'active' : ''}}" data-filter="low" bindtap="setFilter">低课时</view>
        <view class="filter-block {{filter === 'debt' ? 'active' : ''}}" data-filter="debt" bindtap="setFilter">欠课</view>
        <view class="filter-block {{filter === 'done' ? 'active' : ''}}" data-filter="done" bindtap="setFilter">已完成</view>
        <view class="filter-block {{filter === 'monthly' ? 'active' : ''}}" data-filter="monthly" bindtap="setFilter">月卡</view>
      </view>
    </view>

    <view class="member-card" wx:for="{{members}}" wx:key="id" data-id="{{item.id}}" bindtap="editMember">
      <view class="member-card-head">
        <view><view class="member-name">{{item.chineseName}} <text>#{{item.memberNo}}</text></view><view class="member-route">{{item.campus || '未设地点'}} · {{item.coach || '未分配教练'}}</view></view>
        <view class="lesson-balance"><text>{{item.productType === 'monthly' ? '月卡' : item.remainingLessons}}</text><text>{{item.productType === 'monthly' ? item.status : '剩余课时'}}</text></view>
      </view>
      <view class="member-course-line"><text>{{item.productName || '未设课程'}}</text><text wx:if="{{item.productType !== 'monthly'}}">已消 {{item.usedLessons}} / 总 {{item.totalLessons}}</text></view>
      <view wx:if="{{item.productType !== 'monthly'}}" class="lesson-progress"><view style="width: {{item.progressPercent}}%"></view></view>
      <view class="member-card-foot"><text class="status {{item.status === '欠课' ? 'danger' : item.status === '即将用完' ? 'warn' : ''}}">{{item.status}}</text><text class="status {{item.loginTone}}">{{item.loginText}}</text><text class="edit-link">编辑 ›</text></view>
      <view class="member-note" wx:if="{{item.notes}}">{{item.notes}}</view>
    </view>
    <view wx:if="{{!members.length}}" class="section calm-empty">没有符合条件的学员。</view>
  </block>

  <block wx:else>
    <view class="form-header"><text bindtap="closeForm">‹ 返回学员列表</text><view class="title">{{form.id ? '编辑学员' : '新增学员'}}</view><view class="subtitle">老板绑定手机号后，学员输入此号码即可验证进入学员端</view></view>
    <view class="section member-form">
      <view class="form-grid">
        <view class="field"><text class="field-label">姓名</text><input value="{{form.chineseName}}" placeholder="学员姓名" data-field="chineseName" bindinput="input" /></view>
        <view class="field"><text class="field-label">登录手机号</text><input type="number" maxlength="11" value="{{form.phone}}" placeholder="必填，用于学员验证登录" data-field="phone" bindinput="input" /></view>
      </view>
      <view class="field"><text class="field-label">上课地点</text><view class="option-board"><view class="option-block {{form.campus === item ? 'active' : ''}}" wx:for="{{campusOptions}}" wx:key="*this" data-value="{{item}}" bindtap="selectCampus">{{item}}</view></view></view>
      <view class="field"><text class="field-label">教练</text><view class="option-board"><view class="option-block {{form.coach === item ? 'active' : ''}}" wx:for="{{coachOptions}}" wx:key="*this" data-value="{{item}}" bindtap="selectCoach">{{item}}</view></view><view wx:if="{{!coachOptions.length}}" class="inline-warning">请先在老板首页添加教练</view></view>
      <view class="field"><text class="field-label">课程</text><view class="option-board"><view class="option-block {{form.productId === item.id || form.productName === item.name ? 'active' : ''}}" wx:for="{{productOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectProduct"><text>{{item.name}}</text><text class="option-meta">{{item.metaText}}</text></view></view></view>
      <view class="field"><text class="field-label">总课时</text><input type="number" value="{{form.totalLessons}}" placeholder="20" data-field="totalLessons" bindinput="input" /></view>
      <view class="field"><text class="field-label">备注</text><input value="{{form.notes}}" placeholder="家长名、同名区分或特殊说明" data-field="notes" bindinput="input" /></view>
      <view class="login-sync-note" wx:if="{{linkedAccount}}">当前登录账号：{{linkedAccount.account}} · {{linkedAccount.wechatBound ? '微信已绑定' : '等待手机号验证'}}</view>
      <button class="primary wide-action" loading="{{saving}}" bindtap="saveMember">保存学员</button>
    </view>
  </block>
</view>

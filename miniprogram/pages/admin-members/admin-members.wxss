.member-admin-page { padding-bottom: 70rpx; }
.member-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 11rpx; margin-bottom: 16rpx; }
.member-summary > view { padding: 19rpx 10rpx; border-radius: 18rpx; background: #1c3029; color: #fff; text-align: center; }
.member-summary text { display: block; }
.member-summary text:first-child { font-size: 33rpx; font-weight: 850; }
.member-summary text:last-child { margin-top: 4rpx; color: rgba(255,255,255,.62); font-size: 19rpx; }
.member-filter-section { padding: 18rpx; }
.search-input { min-height: 70rpx; background: #f5f7f5; border-color: #e0e6e1; }
.member-filter-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8rpx; margin-top: 14rpx; }
.filter-block { padding: 15rpx 2rpx; border: 1rpx solid #e1e6e2; border-radius: 13rpx; background: #f5f7f5; color: #718079; font-size: 19rpx; font-weight: 800; text-align: center; }
.filter-block.active { color: #fff; background: #176f63; border-color: #176f63; }
.member-card { margin-bottom: 13rpx; padding: 21rpx; border: 1rpx solid #e1e6e2; border-radius: 21rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(28,51,43,.05); }
.member-card-head, .member-course-line, .member-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.member-card-head > view:first-child { min-width: 0; flex: 1; }
.member-name { font-size: 29rpx; font-weight: 850; }
.member-name text { margin-left: 5rpx; color: #8a938f; font-size: 19rpx; font-weight: 700; }
.member-route { margin-top: 6rpx; color: #74807a; font-size: 21rpx; }
.lesson-balance { min-width: 102rpx; text-align: right; }
.lesson-balance text { display: block; }
.lesson-balance text:first-child { color: #176f63; font-size: 34rpx; font-weight: 900; }
.lesson-balance text:last-child { margin-top: 2rpx; color: #7c8781; font-size: 18rpx; }
.member-course-line { margin-top: 17rpx; color: #52615a; font-size: 21rpx; }
.member-course-line text:first-child { font-weight: 800; color: #263b34; }
.lesson-progress { height: 8rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #edf0ed; }
.lesson-progress view { height: 100%; border-radius: 999rpx; background: #63bda5; }
.member-card-foot { justify-content: flex-start; margin-top: 16rpx; padding-top: 15rpx; border-top: 1rpx solid #edf0ed; }
.member-card-foot .edit-link { margin-left: auto; color: #176f63; font-size: 21rpx; font-weight: 850; }
.member-card-foot .status.danger { background: #ffe8e8; color: #c81e1e; }
.member-note { margin-top: 12rpx; padding: 11rpx 14rpx; border-radius: 12rpx; color: #6f7b75; background: #f5f7f5; font-size: 20rpx; }
.form-header { margin: 4rpx 2rpx 24rpx; }
.form-header > text { display: block; margin-bottom: 20rpx; color: #176f63; font-size: 23rpx; font-weight: 800; }
.member-form { padding: 26rpx; }
.option-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.option-block { min-height: 70rpx; padding: 15rpx 8rpx; border: 2rpx solid #e0e6e1; border-radius: 15rpx; background: #f7f9f7; color: #63716a; text-align: center; font-size: 23rpx; font-weight: 800; }
.option-block text { display: block; }
.option-block.active { border-color: #176f63; background: #e8f4f0; color: #176f63; }
.option-meta { margin-top: 4rpx; font-size: 18rpx; font-weight: 600; opacity: .76; }
.inline-warning { padding: 16rpx; border-radius: 14rpx; color: #9b6511; background: #fff2d9; font-size: 21rpx; }
.login-sync-note { margin-top: 8rpx; padding: 15rpx 17rpx; border-radius: 14rpx; color: #52615a; background: #f2f5f3; font-size: 21rpx; }
@media (max-width: 360px) { .member-filter-row { grid-template-columns: repeat(3, 1fr); } .option-board { grid-template-columns: repeat(2, 1fr); } }

.registration-admin{padding-bottom:90rpx}.pending-pill{padding:12rpx 18rpx;border-radius:999rpx;background:#174d41;color:#fff;font-size:21rpx;font-weight:900;white-space:nowrap}.guide-card{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-bottom:18rpx;padding:20rpx;border-radius:26rpx;background:#ede9de}.guide-step{min-width:0}.guide-step>text{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;margin-bottom:12rpx;border-radius:14rpx;background:#d5a84a;color:#173d35;font-weight:950}.guide-step>view>view:first-child{font-size:23rpx;font-weight:900}.guide-step>view>view:last-child{margin-top:4rpx;color:#748079;font-size:18rpx;line-height:1.45}.qr-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.qr-card{min-width:0;padding:18rpx;border:1rpx solid #e0e2dc;border-radius:22rpx;background:#fafaf7}.qr-top{display:flex;align-items:center;gap:12rpx}.qr-letter{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;border-radius:17rpx;background:#174d41;color:#fff;font-size:27rpx;font-weight:950;flex-shrink:0}.qr-card:nth-child(2) .qr-letter{background:#d5a84a;color:#173d35}.qr-title{font-size:23rpx;font-weight:900}.qr-note{margin-top:3rpx;color:#7b8781;font-size:17rpx;line-height:1.35}.qr-image{display:flex;align-items:center;justify-content:center;aspect-ratio:1;margin:16rpx 0;border-radius:18rpx;background:#fff;overflow:hidden}.qr-image image{width:100%;height:100%}.qr-placeholder{text-align:center;color:#809089}.qr-placeholder text{display:block;color:#174d41;font-size:72rpx;font-weight:950}.qr-placeholder view{font-size:18rpx}.qr-actions{display:flex;gap:8rpx}.qr-actions button{min-width:0;flex:1;padding:0 8rpx;font-size:19rpx}.qr-actions .quiet{background:#f0f1ed;color:#52625b}.pending-number{display:flex;align-items:center;justify-content:center;min-width:48rpx;height:48rpx;border-radius:15rpx;background:#f0e2c4;color:#74541c;font-size:22rpx;font-weight:950}.request-card{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-top:1rpx solid #e8e8e2}.request-card:first-of-type{border-top:0}.request-type{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#174d41;color:#fff;font-weight:950;flex-shrink:0}.request-type.student{background:#d5a84a;color:#173d35}.request-main{min-width:0;flex:1}.request-title{font-size:25rpx;font-weight:900}.request-phone{margin-top:4rpx;color:#3d5149;font-size:23rpx;font-weight:700}.request-note{margin-top:3rpx;color:#7b8781;font-size:20rpx}.review-link{color:#176f63;font-size:22rpx;font-weight:900}.empty-mark{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;margin:0 auto 12rpx;border-radius:18rpx;background:#e4efe9;color:#176f63;font-weight:950}.review-mask{align-items:flex-end;padding:0;background:rgba(20,31,27,.48)}.review-sheet{width:100%;max-height:90vh;padding:18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));overflow-y:auto;border-radius:34rpx 34rpx 0 0;background:#fff;text-align:left}.sheet-handle{width:74rpx;height:8rpx;margin:0 auto 22rpx;border-radius:99rpx;background:#d9ddd9}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22rpx}.close-button{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;background:#f0f1ed;color:#637069;font-size:35rpx}.locked-phone{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;padding:20rpx;border-radius:20rpx;background:#edf3ef}.locked-label{color:#718078;font-size:20rpx}.locked-value{margin-top:4rpx;color:#1f3830;font-size:30rpx;font-weight:950;letter-spacing:1rpx}.lock-badge{padding:8rpx 12rpx;border-radius:12rpx;background:#dbe7e0;color:#486258;font-size:18rpx;font-weight:850}.review-help{margin-bottom:16rpx;color:#6f7c75;font-size:22rpx;line-height:1.55}.review-child{margin-bottom:14rpx;padding:20rpx;border-radius:22rpx;background:#f7f7f3}.review-child-title{margin-bottom:15rpx;color:#174d41;font-size:24rpx;font-weight:950}.sheet-actions{display:grid;grid-template-columns:1fr 2fr;gap:12rpx;margin-top:24rpx}.sheet-actions button{width:100%;min-height:84rpx;line-height:84rpx}.approve-button{margin:0}.reject-button{margin:0}@media(max-width:360px){.qr-grid{grid-template-columns:1fr}.guide-card{grid-template-columns:1fr}.guide-step{display:flex;gap:12rpx}.guide-step>text{margin:0}.qr-image{max-height:420rpx}}

.intake-grid{display:grid;gap:12rpx;margin-bottom:18rpx}.intake-card{display:flex;align-items:center;gap:18rpx;min-height:116rpx;padding:20rpx 22rpx;border:1rpx solid #e2e3dc;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(42,54,48,.045)}.intake-card.featured{background:linear-gradient(135deg,#174d41,#113c33);border-color:#174d41;color:#fff}.intake-icon{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;flex-shrink:0;border-radius:18rpx;background:#d9b87d;color:#173d35;font-size:23rpx;font-weight:950}.intake-icon.sheet{background:#e2eee8;color:#235f51}.intake-icon.manual{background:#eee7dc;color:#765d38}.intake-copy{min-width:0;flex:1}.intake-title{font-size:27rpx;font-weight:950}.intake-note{margin-top:5rpx;color:#748079;font-size:20rpx;line-height:1.4}.featured .intake-note{color:rgba(255,255,255,.7)}.intake-card>text{color:#809089;font-size:38rpx}.featured>text{color:rgba(255,255,255,.65)}

.qr-image{height:250rpx;aspect-ratio:auto}.qr-actions button,.sheet-actions button{min-height:88rpx;line-height:88rpx}.close-button{width:88rpx;height:88rpx}.review-sheet input{min-height:88rpx}@media(min-width:700px){.registration-admin{max-width:1100rpx;margin:0 auto}.review-sheet{max-width:900rpx;margin:0 auto}}
.registration-error{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:18rpx;padding:20rpx;border:1rpx solid #efd1cb;border-radius:18rpx;background:#fff4f1}.registration-error>view{min-width:0;flex:1}.error-title{color:#8d4035;font-size:23rpx;font-weight:900}.error-note{margin-top:4rpx;color:#82675f;font-size:19rpx;line-height:1.4}.qr-loading{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:18rpx;color:#7b8781;font-size:20rpx}.qr-loading>view:last-child{grid-column:1/-1}.qr-skeleton{height:220rpx;border-radius:18rpx;background:linear-gradient(110deg,#eceeea 30%,#f8f8f4 45%,#eceeea 60%);background-size:220% 100%;animation:qr-shimmer 1.4s linear infinite}@keyframes qr-shimmer{to{background-position-x:-220%}}

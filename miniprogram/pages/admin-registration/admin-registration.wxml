<view class="page registration-admin">
  <view class="app-header"><view><view class="eyebrow">人员入口</view><view class="title">自助登记</view><view class="subtitle">把二维码发到群里，申请统一由你确认</view></view><view class="pending-pill">待确认 {{pendingCount}}</view></view>

  <view class="guide-card"><view class="guide-step"><text>1</text><view><view>发到群里</view><view>教练扫 A，家长扫 B</view></view></view><view class="guide-step"><text>2</text><view><view>你来核对</view><view>修改姓名和剩余课时</view></view></view><view class="guide-step"><text>3</text><view><view>确认开通</view><view>之后直接用手机号登录</view></view></view></view>

  <view class="section qr-section"><view class="section-head"><view><view class="section-title">长期登记码</view><view class="section-note">可反复使用；需要时可更换并让旧码失效</view></view></view>
    <view class="qr-grid">
      <view class="qr-card" wx:for="{{invites}}" wx:key="inviteType">
        <view class="qr-top"><view class="qr-letter">{{item.letter}}</view><view><view class="qr-title">{{item.title}}</view><view class="qr-note">{{item.note}}</view></view></view>
        <view class="qr-image" data-type="{{item.inviteType}}" bindtap="previewInvite"><image wx:if="{{item.fileId}}" src="{{item.fileId}}" mode="aspectFit"></image><view wx:else class="qr-placeholder"><text>{{item.letter}}</text><view>开发预览码</view></view></view>
        <view class="qr-actions"><button class="primary mini" data-type="{{item.inviteType}}" bindtap="previewInvite" disabled="{{!item.fileId}}">放大二维码</button><button class="mini quiet" data-type="{{item.inviteType}}" bindtap="rotateInvite">更换</button></view>
      </view>
    </view>
  </view>

  <view class="section requests-section"><view class="section-head"><view><view class="section-title">等待你确认</view><view class="section-note">申请不会自动变成教练或学员</view></view><view class="pending-number">{{pendingCount}}</view></view>
    <view class="request-card" wx:for="{{requests}}" wx:key="id" data-id="{{item.id}}" bindtap="openReview">
      <view class="request-type {{item.requestType}}">{{item.requestType === 'coach' ? 'A' : 'B'}}</view>
      <view class="request-main"><view class="request-title">{{item.requestType === 'coach' ? '新教练申请' : '新学员申请'}}</view><view class="request-phone">{{item.phone}}</view><view class="request-note" wx:if="{{item.requestType === 'student'}}">{{item.children.length}} 名孩子 · {{item.children[0].proposedName}}{{item.children.length > 1 ? ' 等' : ''}}</view><view class="request-note" wx:else>等待设置教练姓名</view></view><view class="review-link">核对 ›</view>
    </view>
    <view wx:if="{{!loading && !requests.length}}" class="calm-empty"><view class="empty-mark">清</view><view>暂时没有待确认申请</view></view>
    <view wx:if="{{loading}}" class="calm-empty">正在读取申请…</view>
  </view>

  <view class="modal-mask review-mask" wx:if="{{reviewVisible}}" bindtap="closeReview"><view class="review-sheet" catchtap="noop">
    <view class="sheet-handle"></view><view class="sheet-head"><view><view class="eyebrow">老板确认</view><view class="modal-title">{{review.requestType === 'coach' ? '开通教练' : '建立学员档案'}}</view></view><view class="close-button" bindtap="closeReview">×</view></view>
    <view class="locked-phone"><view><view class="locked-label">微信验证手机号</view><view class="locked-value">{{review.phone}}</view></view><view class="lock-badge">不可修改</view></view>
    <block wx:if="{{review.requestType === 'coach'}}"><label class="field"><text class="field-label">教练姓名</text><input value="{{review.displayName}}" placeholder="例如：陈教练" data-field="displayName" bindinput="reviewInput" /></label><label class="field"><text class="field-label">校区（可选）</text><input value="{{review.campus}}" placeholder="例如：绿洲" data-field="campus" bindinput="reviewInput" /></label></block>
    <block wx:else><view class="review-help">下面的姓名和课时都可以修正，确认后写入正式档案。</view><view class="review-child" wx:for="{{review.children}}" wx:key="clientId"><view class="review-child-title">孩子 {{index + 1}}</view><label class="field"><text class="field-label">系统姓名</text><input value="{{item.proposedName}}" data-index="{{index}}" data-field="proposedName" bindinput="childInput" /></label><label class="field"><text class="field-label">剩余课时</text><input type="number" value="{{item.remainingLessons}}" data-index="{{index}}" data-field="remainingLessons" bindinput="childInput" /></label></view></block>
    <view class="sheet-actions"><button class="danger reject-button" bindtap="reject" disabled="{{saving}}">拒绝</button><button class="primary approve-button" bindtap="approve" loading="{{saving}}">确认并开通</button></view>
  </view></view>
</view>

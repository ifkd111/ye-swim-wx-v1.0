<view class="page">
  <view class="topbar">
    <view>
      <view class="title">我的排课</view>
      <view class="subtitle">本周、待确认、已完成都在这里</view>
    </view>
  </view>

  <view class="card">
    <view class="row scan-head">
      <view>
        <view class="card-title">扫码核销</view>
        <view class="meta">扫描学员上课二维码后自动确认出勤</view>
      </view>
      <button class="primary mini" bindtap="scanVerify">扫码</button>
    </view>
    <view class="chip-list">
      <view class="chip {{filter === 'week' ? 'active' : ''}}" bindtap="setFilter" data-filter="week">本周 {{stats.week}}</view>
      <view class="chip {{filter === 'pending' ? 'active' : ''}}" bindtap="setFilter" data-filter="pending">待确认 {{stats.pending}}</view>
      <view class="chip {{filter === 'completed' ? 'active' : ''}}" bindtap="setFilter" data-filter="completed">已完成</view>
      <view class="chip {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部 {{stats.all}}</view>
    </view>
  </view>

  <view class="card">
    <block wx:if="{{visibleSchedules.length}}">
      <view class="list-item" wx:for="{{visibleSchedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.dayLabel}} · {{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}}</view>
            <view class="meta">{{item.verificationStatusText}} · {{item.verificationPayload}}</view>
          </view>
          <text class="badge {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <button wx:if="{{item.canMark}}" class="primary confirm-button" data-id="{{item.id}}" bindtap="mark">确认出勤</button>
      </view>
    </block>
    <view wx:else class="empty">暂无排课</view>
  </view>

  <view class="modal-mask" wx:if="{{feedbackVisible}}" bindtap="hideFeedback">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">课后反馈</view>
      <view class="modal-meta">选择标签或写一句成长记录</view>
      <view class="chip-list status-filter">
        <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{feedbackOptions}}" wx:key="label" data-tag="{{item.label}}" bindtap="toggleFeedbackTag">{{item.label}}</view>
      </view>
      <view class="field"><textarea value="{{feedbackNote}}" placeholder="例如：换气节奏更稳，后半节注意腿部发力" bindinput="feedbackNoteInput" /></view>
      <view class="toolbar">
        <button bindtap="hideFeedback">稍后</button>
        <button class="primary" bindtap="submitFeedback">保存反馈</button>
      </view>
    </view>
  </view>
</view>

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.chip {
  min-width: calc((100% - 36rpx) / 4);
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid #d5e7fb;
  background: #eef6ff;
  color: #12325b;
  font-weight: 800;
  font-size: 22rpx;
}

.chip.active {
  background: #1268cf;
  border-color: #1268cf;
  color: #ffffff;
}

.confirm-button {
  width: 100%;
  margin-top: 16rpx;
}

.scan-head button {
  flex-shrink: 0;
}

.checkin-page{padding-bottom:80rpx}.center-state{padding:180rpx 0;color:#66756e;text-align:center}.hero-card{padding:36rpx;border-radius:28rpx;background:#153f39;color:#fff}.hero-card .eyebrow{color:rgba(255,255,255,.72)}.coach-name{margin-top:12rpx;font-size:48rpx;font-weight:900}.hero-meta{margin-top:10rpx;color:rgba(255,255,255,.78);font-size:23rpx}.member-list{display:grid;gap:16rpx;margin-top:22rpx}.member-card{overflow:hidden;border:2rpx solid #dfe6e2;border-radius:20rpx;background:#fff;transition:border-color .2s ease,background-color .2s ease}.member-card.active{border-color:#4f9f91;background:#f3faf7}.member-head{min-height:88rpx;display:flex;justify-content:space-between;align-items:center;gap:18rpx;padding:20rpx 22rpx}.attendance-state{min-width:104rpx;padding:14rpx 16rpx;border-radius:999rpx;background:#edf0ee;color:#66736d;text-align:center;font-size:21rpx;font-weight:850}.attendance-state.active{background:#dcefe8;color:#176f63}.member-lessons{display:flex;align-items:center;gap:18rpx;padding:0 22rpx 22rpx}.member-lessons-label{flex-shrink:0;color:#53625b;font-size:22rpx;font-weight:800}.name{font-size:29rpx;font-weight:850}.meta{margin-top:7rpx;color:#66756e;font-size:22rpx}.lesson-options{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:20rpx}.lesson-options.compact{flex:1;gap:12rpx;margin-top:0}.lesson-option{min-height:88rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #d9e2dd;border-radius:18rpx;background:#fff;text-align:center;font-size:27rpx;font-weight:850;transition:border-color .2s ease,background-color .2s ease,color .2s ease}.lesson-option.active{border-color:#176f63;background:#176f63;color:#fff}.confirm-summary{margin:26rpx 0 14rpx;color:#43534c;text-align:center;font-size:24rpx;font-weight:750}.success-mark{width:112rpx;height:112rpx;margin:70rpx auto 20rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#176f63;color:#fff;font-size:60rpx}.success-title{text-align:center;font-size:48rpx;font-weight:900}.success-sub{margin-top:10rpx;color:#617169;text-align:center}.receipt-list{margin-top:34rpx}.receipt-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0;border-top:1rpx solid #e8ece9}.receipt-row:first-child{border-top:0}.balance{color:#176f63;font-size:27rpx;font-weight:900}.balance.debt{color:#c14b3b}

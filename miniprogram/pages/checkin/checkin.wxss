.checkin-page{padding-bottom:80rpx}.center-state{padding:180rpx 0;color:#7b8781;text-align:center}.hero-card{padding:36rpx;border-radius:28rpx;background:#153f39;color:#fff}.hero-card .eyebrow{color:rgba(255,255,255,.65)}.coach-name{margin-top:12rpx;font-size:48rpx;font-weight:900}.hero-meta{margin-top:10rpx;color:rgba(255,255,255,.7);font-size:23rpx}.member-list{display:grid;gap:14rpx;margin-top:22rpx}.member-choice{display:flex;justify-content:space-between;align-items:center;padding:22rpx;border:2rpx solid #e2e8e4;border-radius:20rpx}.member-choice.active{border-color:#176f63;background:#edf7f3}.member-choice>text{font-size:30rpx;font-weight:900;color:#176f63}.name{font-size:29rpx;font-weight:850}.meta{margin-top:7rpx;color:#77827d;font-size:22rpx}.lesson-options{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:20rpx}.lesson-option{padding:24rpx 0;border:2rpx solid #e1e6e2;border-radius:18rpx;text-align:center;font-size:29rpx;font-weight:850}.lesson-option.active{border-color:#176f63;background:#176f63;color:#fff}.confirm-summary{margin:26rpx 0 14rpx;color:#53615a;text-align:center;font-size:24rpx}.success-mark{width:112rpx;height:112rpx;margin:70rpx auto 20rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#176f63;color:#fff;font-size:60rpx}.success-title{text-align:center;font-size:48rpx;font-weight:900}.success-sub{margin-top:10rpx;color:#718078;text-align:center}.receipt-list{margin-top:34rpx}.receipt-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0;border-top:1rpx solid #e8ece9}.receipt-row:first-child{border-top:0}.balance{color:#176f63;font-size:27rpx;font-weight:900}.balance.debt{color:#c14b3b}

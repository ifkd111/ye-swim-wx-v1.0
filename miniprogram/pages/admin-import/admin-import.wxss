.import-page{padding-bottom:90rpx}.format-card{margin-bottom:16rpx;padding:24rpx;border-radius:26rpx;background:#ece8dd}.format-head{display:flex;align-items:center;gap:16rpx;margin-bottom:20rpx}.format-mark,.file-icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:17rpx;background:#174d41;color:#fff;font-size:21rpx;font-weight:950}.format-title{font-size:27rpx;font-weight:950}.format-note{margin-top:4rpx;color:#6f7c75;font-size:20rpx}.format-line{display:grid;grid-template-columns:150rpx 1fr;gap:12rpx;padding:12rpx 0;border-top:1rpx solid rgba(74,84,77,.1);font-size:20rpx;line-height:1.45}.format-line text:first-child{color:#174d41;font-weight:900}.format-line text:last-child{color:#66736d}.same-phone-tip{margin-top:14rpx;padding:14rpx 16rpx;border-radius:15rpx;background:rgba(255,255,255,.58);color:#5c6963;font-size:20rpx;line-height:1.5}.upload-card{padding:54rpx 28rpx;text-align:center;border:2rpx dashed #b9c8c1;border-radius:28rpx;background:rgba(255,255,255,.75)}.upload-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;margin:0 auto 18rpx;border-radius:23rpx;background:#e3eee8;color:#176f63;font-size:38rpx}.upload-title{font-size:29rpx;font-weight:950}.upload-note{margin-top:8rpx;color:#77827c;font-size:21rpx;line-height:1.5}.choose-button{margin:24rpx auto 0;width:280rpx}.file-row{display:flex;align-items:center;gap:16rpx}.file-row>view:nth-child(2){min-width:0;flex:1}.file-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx;font-weight:900}.file-row>text{color:#176f63;font-size:22rpx;font-weight:900}.progress{height:12rpx;margin-top:22rpx;overflow:hidden;border-radius:99rpx;background:#e6e9e5}.progress>view{height:100%;border-radius:99rpx;background:#347d6d;transition:width .2s}.error-card,.done-card{text-align:center}.error-mark,.done-mark{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;margin:0 auto 18rpx;border-radius:22rpx;background:#fff0ed;color:#b04b3c;font-size:34rpx;font-weight:950}.done-mark{background:#e1efe8;color:#176f63}.error-text{margin-top:12rpx;color:#8f4338;font-size:22rpx;line-height:1.5}.error-help{margin-top:12rpx;color:#7d8581;font-size:20rpx;line-height:1.5}.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-bottom:16rpx}.summary-grid>view{min-width:0;padding:22rpx 10rpx;border:1rpx solid #e3e4de;border-radius:22rpx;background:#fff;text-align:center}.summary-grid text{display:block}.summary-grid text:first-child{color:#174d41;font-size:37rpx;font-weight:950}.summary-grid text:nth-child(2){margin-top:3rpx;font-size:21rpx;font-weight:900}.summary-grid text:last-child{margin-top:7rpx;color:#7a8580;font-size:17rpx}.summary-grid .bad text:first-child{color:#ae4739}.summary-grid .good text:first-child{color:#347d6d}.change-link{padding:16rpx}.issue{display:flex;align-items:flex-start;gap:14rpx;padding:15rpx 0;border-top:1rpx solid #eceae4}.issue>text{min-width:82rpx;padding:7rpx 8rpx;border-radius:10rpx;background:#fff0ed;color:#a84438;text-align:center;font-size:17rpx;font-weight:900}.issue>view{min-width:0;flex:1}.issue>view>view:first-child{font-size:22rpx;font-weight:900}.issue>view>view:last-child{margin-top:3rpx;color:#7c6863;font-size:20rpx;line-height:1.4}.issue.warning>text{background:#fff3db;color:#90620e}.preview-row{display:flex;align-items:center;gap:14rpx;padding:16rpx 0;border-top:1rpx solid #eceae4}.row-badge{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;flex-shrink:0;border-radius:15rpx;background:#e0eee7;color:#176f63;font-size:19rpx;font-weight:950}.row-badge.student{background:#f1e6d1;color:#805f27}.preview-row>view:nth-child(2){min-width:0;flex:1}.preview-name{font-size:23rpx;font-weight:900}.action-tag{padding:6rpx 10rpx;border-radius:10rpx;background:#e3eee8;color:#176f63;font-size:17rpx;font-weight:900}.action-tag.update{background:#eeeae2;color:#6e6047}.confirm-button{position:sticky;bottom:24rpx;width:100%;min-height:90rpx;line-height:90rpx;box-shadow:0 16rpx 38rpx rgba(22,72,61,.24)}.done-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:24rpx}.done-actions button{width:100%}.again{margin-top:24rpx;padding:18rpx;color:#176f63;font-size:22rpx;font-weight:900}@media(min-width:700px){.import-page{max-width:1000rpx;margin:0 auto}}

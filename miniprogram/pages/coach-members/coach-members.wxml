<view class="page">
  <view class="topbar">
    <view>
      <view class="title">我的学员</view>
      <view class="subtitle">{{viewer.coachName || viewer.fullName}} · 已分配学员</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">共 {{members.length}} 位</view>
    <block wx:if="{{members.length}}">
      <view class="list-item" wx:for="{{members}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.chineseName}}</view>
            <view class="meta">#{{item.memberNo}} · {{item.campus}} · {{item.productName}}</view>
            <view class="meta">总 {{item.totalLessons}} / 已消 {{item.usedLessons}} / 剩余 {{item.remainingLessons}}</view>
            <view class="meta" wx:if="{{item.notes}}">备注：{{item.notes}}</view>
          </view>
          <text class="badge {{item.status === '欠课' ? 'danger' : item.status === '即将用完' ? 'warn' : ''}}">{{item.status}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无分配学员</view>
  </view>
</view>

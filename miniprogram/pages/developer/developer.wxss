.developer-page{padding-bottom:80rpx}.help-button{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;border-radius:20rpx;background:#e7ebe8;color:#456158;font-size:25rpx;font-weight:950}.readonly-banner{display:flex;align-items:center;gap:16rpx;margin-bottom:18rpx;padding:20rpx;border-radius:22rpx;background:#eee8dc}.lock-mark{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:18rpx;background:#d7b97e;color:#173d35;font-size:20rpx;font-weight:950}.readonly-banner>view:last-child>view:first-child{font-size:24rpx;font-weight:950}.readonly-banner>view:last-child>view:last-child{margin-top:4rpx;color:#6f7772;font-size:19rpx;line-height:1.4}.role-card{display:flex;align-items:center;gap:18rpx;margin-bottom:13rpx;padding:22rpx;border:1rpx solid #e2e3dc;border-radius:25rpx;background:#fff}.role-card.owner{background:linear-gradient(135deg,#174d41,#103a31);color:#fff}.role-mark{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;flex-shrink:0;border-radius:20rpx;background:#d9b87d;color:#173d35;font-size:22rpx;font-weight:950}.role-mark.coach{background:#e0eee7;color:#176f63}.role-mark.student{background:#f0e6d4;color:#795b2d}.role-copy{min-width:0;flex:1}.role-title{font-size:27rpx;font-weight:950}.role-meta{margin-top:5rpx;color:#7b8781;font-size:20rpx}.owner .role-meta{color:rgba(255,255,255,.68)}.role-card>text{font-size:38rpx;color:rgba(255,255,255,.7)}.account-picker{margin-top:7rpx;color:#176f63;font-size:21rpx;font-weight:900}.role-card button{min-width:120rpx}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:22rpx}

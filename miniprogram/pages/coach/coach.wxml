<view class="page">
  <view class="topbar">
    <view>
      <view class="title">教练工作台</view>
      <view class="subtitle">{{viewer.fullName || viewer.coachName}} · 本周课程与出勤</view>
    </view>
    <view class="top-actions">
      <button class="mini" bindtap="changePassword">改密码</button>
      <button bindtap="logout">退出</button>
    </view>
  </view>

  <view class="grid">
    <view class="metric tappable" bindtap="goSchedule" data-filter="pending">
      <text class="metric-value">{{stats.pending}}</text>
      <text class="metric-label">待确认</text>
    </view>
    <view class="metric tappable" bindtap="goMembers">
      <text class="metric-value">{{stats.members}}</text>
      <text class="metric-label">我的学员</text>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view>
        <view class="card-title">本周课程</view>
        <view class="meta">管理员已安排，教练可确认出勤</view>
      </view>
      <button class="mini" bindtap="goSchedule" data-filter="week">查看全部</button>
    </view>
    <block wx:if="{{weekSchedules.length}}">
      <view class="list-item" wx:for="{{weekSchedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.dayLabel}} · {{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}}</view>
          </view>
          <text class="badge {{item.lessonStatus === 'completed' ? '' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : '待确认'}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.lessonStatus !== 'completed'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="mark">确认出勤</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">本周暂无课程</view>
    <button class="primary wide-action" bindtap="goAvailability">提交空余时间</button>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">已安排课程</view>
      <button class="mini" bindtap="goSchedule" data-filter="all">全部</button>
    </view>
    <block wx:if="{{arrangedSchedules.length}}">
      <view class="list-item tappable" wx:for="{{arrangedSchedules}}" wx:key="id" bindtap="goSchedule" data-filter="all">
        <view class="row">
          <view>
            <view class="name">{{item.dayLabel}} · {{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}}</view>
          </view>
          <text class="badge {{item.lessonStatus === 'completed' ? '' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : '待上课'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无待上课排课</view>
  </view>
</view>

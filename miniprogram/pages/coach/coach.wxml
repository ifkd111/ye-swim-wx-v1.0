<view class="page coach-page">
  <view class="developer-readonly" wx:if="{{viewer.developerReadOnly}}" bindtap="switchDeveloper"><text>只读</text><view>开发者正在查看教练视角</view><text>切换 ›</text></view>
  <view class="app-header"><view><view class="eyebrow">今日教练码</view><view class="title">{{code.coachName || viewer.coachName || viewer.fullName}}</view></view><text class="date-label">{{code.codeDate}}</text></view>
  <view class="profile-strip" bindtap="openProfile"><image wx:if="{{viewer.avatarFileId}}" src="{{viewer.avatarFileId}}" mode="aspectFill"></image><view wx:else class="profile-fallback">微</view><view><view class="profile-name">{{viewer.nickname || '补充微信头像和昵称'}}</view><view class="profile-note">手机号用于登录 · 微信{{viewer.wechatBound ? '已绑定' : '待绑定'}}</view></view><text>›</text></view>
  <view class="qr-card" wx:if="{{code.fileId}}"><view class="qr-status">今日有效</view><view class="qr-frame"><image class="daily-code" src="{{code.fileId}}" mode="aspectFit" bindtap="previewCode"></image></view><view class="qr-title">家长请用微信扫一扫</view><view class="qr-note">今天固定不变，可以截图或转发给家长</view></view>
  <view class="qr-card" wx:else><view class="qr-title">今日教练码暂未生成</view><view class="qr-note">请稍后重新进入本页；仍失败时联系老板</view></view>
  <view class="section stats"><view><text>{{stats.todayStudents || 0}}</text><text>今日学员</text></view><view><text>{{stats.todayLessons || 0}}</text><text>今日消课</text></view></view>
  <view class="section"><view class="section-title">今天的消课</view><view class="log-row" wx:for="{{todayLogs}}" wx:key="id"><view><view class="name">{{item.memberName}}</view><view class="meta">{{item.attendanceTime || '已记录'}}</view></view><text class="lessons">{{item.lessonsDeducted}} 节</text></view><view wx:if="{{!todayLogs.length}}" class="empty">今天还没有学员扫码</view></view>
  <view class="logout" bindtap="logout">退出登录</view>
  <view class="modal-mask profile-mask" wx:if="{{profileVisible}}" bindtap="closeProfile"><view class="modal-card profile-card" catchtap="noop"><view class="modal-title">头像与昵称</view><view class="modal-meta">仅用于辨认账号，不会读取或展示真实微信号</view><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{profileAvatar}}" src="{{profileAvatar}}" mode="aspectFill"></image><view wx:else>选头像</view></button><view class="field"><text class="field-label">微信昵称</text><input type="nickname" maxlength="24" value="{{profileNickname}}" placeholder="请输入昵称" bindinput="profileNicknameInput" /></view><button class="primary wide-action" loading="{{profileSaving}}" bindtap="saveProfile">保存资料</button></view></view>
</view>

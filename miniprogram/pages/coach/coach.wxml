<view class="page">
  <view class="topbar">
    <view>
      <view class="title">教练工作台</view>
      <view class="subtitle">{{viewer.fullName || viewer.coachName}} · 今日课程与出勤</view>
    </view>
    <button bindtap="logout">退出</button>
  </view>

  <view class="grid">
    <view class="metric">
      <text class="metric-value">{{stats.pending}}</text>
      <text class="metric-label">待确认</text>
    </view>
    <view class="metric">
      <text class="metric-value">{{stats.members}}</text>
      <text class="metric-label">我的学员</text>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="card-title">今日课程</view>
      <button bindtap="goAvailability">提交空余</button>
    </view>
    <block wx:if="{{todaySchedules.length}}">
      <view class="list-item" wx:for="{{todaySchedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}}</view>
          </view>
          <text class="badge {{item.lessonStatus === 'completed' ? '' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : '待确认'}}</text>
        </view>
        <view class="toolbar" wx:if="{{item.lessonStatus !== 'completed'}}">
          <button class="primary" data-id="{{item.id}}" bindtap="mark">确认出勤</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">今天暂无课程</view>
  </view>

  <view class="card">
    <view class="card-title">近期排课</view>
    <block wx:if="{{schedules.length}}">
      <view class="list-item" wx:for="{{schedules}}" wx:key="id">
        <view class="row">
          <view>
            <view class="name">{{item.memberName}}</view>
            <view class="meta">{{item.lessonDate}} {{item.lessonTime}} · {{item.campus}}</view>
          </view>
          <text class="badge {{item.lessonStatus === 'completed' ? '' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : '待上课'}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无排课</view>
  </view>
</view>

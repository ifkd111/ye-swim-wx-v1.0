.coach-page{padding-bottom:80rpx}.date-label{padding:10rpx 14rpx;border-radius:999rpx;background:#ebe9e2;color:#66736c;font-size:21rpx}.qr-card{position:relative;overflow:hidden;margin-top:24rpx;padding:38rpx 30rpx 34rpx;border-radius:34rpx;background:linear-gradient(160deg,#184d42 0%,#10382f 100%);text-align:center;box-shadow:0 20rpx 46rpx rgba(23,67,57,.2)}.qr-card::before{content:"";position:absolute;width:250rpx;height:250rpx;right:-110rpx;top:-130rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:50%}.qr-status{position:absolute;left:26rpx;top:24rpx;padding:9rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.12);color:rgba(255,255,255,.86);font-size:19rpx;font-weight:800}.qr-frame{margin:40rpx auto 26rpx;padding:16rpx;width:532rpx;height:532rpx;border-radius:28rpx;background:#fff;box-shadow:0 14rpx 34rpx rgba(6,28,22,.22)}.daily-code{width:500rpx;height:500rpx;border-radius:18rpx}.qr-title{font-size:33rpx;font-weight:900;color:#fff}.qr-note{margin-top:10rpx;color:rgba(255,255,255,.66);font-size:22rpx}.stats{display:grid;grid-template-columns:repeat(2,1fr);text-align:center}.stats>view+view{border-left:1rpx solid #e6e5de}.stats text{display:block}.stats text:first-child{font-size:44rpx;font-weight:900;color:#246656}.stats text:last-child{margin-top:7rpx;color:#7b8781;font-size:22rpx}.log-row{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-top:1rpx solid #ebe9e2}.log-row:first-of-type{border-top:0}.name{font-size:28rpx;font-weight:900}.meta{margin-top:5rpx;color:#7c8782;font-size:22rpx}.lessons{color:#246656;font-size:27rpx;font-weight:900}.empty{padding:42rpx 0;color:#8a948f;text-align:center}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:23rpx}.load-state{margin-top:22rpx;padding:24rpx;border:1rpx solid #e1e3dc;border-radius:24rpx;background:#fff;color:#748079;font-size:22rpx}.loading-line{width:58%;height:16rpx;margin-bottom:13rpx;border-radius:99rpx;background:#e6ebe8}.loading-line.wide{width:82%;height:22rpx}.load-error{color:#61483f}.state-title{color:#7f3f34;font-size:25rpx;font-weight:900}.state-note{margin:7rpx 0 16rpx;color:#7b6861;line-height:1.45}.code-retry{position:relative;z-index:2;margin:22rpx auto 0;background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.3);color:#fff}

.coach-page { padding-bottom: 70rpx; }
.scan-action { padding: 16rpx 20rpx; border-radius: 16rpx; background: #163f38; color: #fff; font-size: 22rpx; font-weight: 800; }
.date-strip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin-bottom: 20rpx; }
.date-block { min-height: 92rpx; padding: 12rpx 2rpx; border-radius: 16rpx; text-align: center; color: #7a847f; background: rgba(255,255,255,.72); }
.date-block text { display: block; font-size: 18rpx; }
.date-block .date-strong { margin-top: 6rpx; font-size: 27rpx; font-weight: 850; }
.date-block.active { background: #163f38; color: #fff; }
.today-section { border-top: 8rpx solid #315dca; }
.coach-lesson { display: grid; grid-template-columns: 112rpx 1fr auto; gap: 14rpx; align-items: center; padding: 22rpx 0; border-top: 1rpx solid #e7ebe8; }
.coach-lesson:first-of-type { border-top: 0; }
.lesson-time { color: #176f63; font-size: 25rpx; font-weight: 850; }
.lesson-title { font-size: 28rpx; font-weight: 850; }
.lesson-meta { margin-top: 5rpx; color: #74807a; font-size: 21rpx; }
.attendance-button { min-width: 134rpx; min-height: 64rpx; line-height: 64rpx; padding: 0 16rpx; border-radius: 15rpx; background: #315dca; border-color: #315dca; color: #fff; font-size: 22rpx; }
.availability-section { border-top: 8rpx solid #23836f; }
.submitted-count { color: #176f63; font-size: 21rpx; font-weight: 800; }
.choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-bottom: 16rpx; }
.choice-tile { padding: 18rpx; border-radius: 16rpx; border: 2rpx solid #e2e7e3; text-align: center; }
.choice-tile.active { border-color: #176f63; background: #eaf5f2; }
.time-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 11rpx; }
.time-block { min-height: 100rpx; padding: 15rpx 6rpx; border: 2rpx solid #e2e7e3; border-radius: 17rpx; background: #fafbf9; text-align: center; }
.time-block > text:first-child { display: block; font-size: 22rpx; font-weight: 800; }
.time-state { display: block; margin-top: 7rpx; color: #8a938e; font-size: 18rpx; }
.time-block.active { border-color: #176f63; background: #e6f4f0; color: #0f5c52; }
.time-block.submitted { border-color: #c4d2cc; background: #edf1ef; color: #78817d; }
.time-block.submitted .time-state { color: #1b866f; }
.submit-times { width: 100%; margin-top: 18rpx; border-radius: 17rpx; background: #176f63; border-color: #176f63; color: #fff; }
.utility-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.utility-tile { min-height: 110rpx; padding: 18rpx; border-radius: 18rpx; background: #f3f6f3; }
.utility-tile text { display: block; }
.utility-strong { font-size: 29rpx; font-weight: 850; color: #263d36; }
.utility-tile text:last-child { margin-top: 5rpx; color: #78827d; font-size: 21rpx; }
.utility-row { display: flex; justify-content: center; padding: 30rpx 0; color: #75817a; font-size: 22rpx; }

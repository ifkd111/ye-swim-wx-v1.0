.coach-page{padding-bottom:80rpx}.date-label{color:#77847e;font-size:23rpx}.qr-card{margin-top:24rpx;padding:34rpx;border-radius:28rpx;background:#fff;text-align:center;box-shadow:0 14rpx 38rpx rgba(29,61,51,.09)}.daily-code{width:500rpx;height:500rpx}.qr-title{font-size:34rpx;font-weight:900;color:#173f39}.qr-note{margin-top:10rpx;color:#7a8781;font-size:23rpx}.stats{display:grid;grid-template-columns:repeat(2,1fr);text-align:center}.stats>view+view{border-left:1rpx solid #e4e9e5}.stats text{display:block}.stats text:first-child{font-size:44rpx;font-weight:900;color:#176f63}.stats text:last-child{margin-top:7rpx;color:#7b8781;font-size:22rpx}.log-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-top:1rpx solid #e8ece9}.log-row:first-of-type{border-top:0}.name{font-size:28rpx;font-weight:850}.meta{margin-top:5rpx;color:#7c8782;font-size:22rpx}.lessons{color:#176f63;font-size:27rpx;font-weight:900}.empty{padding:42rpx 0;color:#8a948f;text-align:center}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:23rpx}

<view class="page">
  <view class="topbar">
    <view>
      <view class="title">修改密码</view>
      <view class="subtitle">当前账号：{{session.account}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">原密码</text>
      <input password value="{{form.oldPassword}}" placeholder="请输入现在使用的密码" bindinput="input" data-field="oldPassword" />
    </view>
    <view class="field">
      <text class="field-label">新密码</text>
      <input password value="{{form.newPassword}}" placeholder="至少 4 位" bindinput="input" data-field="newPassword" />
    </view>
    <view class="field">
      <text class="field-label">确认新密码</text>
      <input password value="{{form.confirmPassword}}" placeholder="再输入一次新密码" bindinput="input" data-field="confirmPassword" />
    </view>
    <button class="primary" loading="{{loading}}" bindtap="submit">保存新密码</button>
    <view class="meta password-note">账号名不能自己修改，如需换账号请联系管理员。</view>
  </view>
</view>

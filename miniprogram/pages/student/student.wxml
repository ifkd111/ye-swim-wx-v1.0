<view class="page">
  <view class="topbar">
    <view><view class="title">我的课程</view><view class="subtitle">{{member.chineseName || viewer.fullName}}</view></view>
    <view class="top-actions"><button class="mini" bindtap="changePassword">改密码</button><button bindtap="logout">退出</button></view>
  </view>

  <view class="card" wx:if="{{member.id}}">
    <view class="row"><view><view class="name">{{member.productName}}</view><view class="meta">{{member.campus}} · {{member.coach}}</view></view><text class="badge {{member.status === '欠课' ? 'danger' : member.status === '即将用完' ? 'warn' : ''}}">{{member.status}}</text></view>
    <view class="grid balance-grid">
      <view class="metric"><text class="metric-value">{{member.totalLessons}}</text><text class="metric-label">总课时</text></view>
      <view class="metric tappable" bindtap="goRecords"><text class="metric-value">{{member.usedLessons}}</text><text class="metric-label">已消课 · 看记录</text></view>
      <view class="metric tappable action-metric" bindtap="goBooking"><text class="metric-value">{{member.remainingLessons}}</text><text class="metric-label">剩余课时 · 去预约</text></view>
      <view class="metric tappable" bindtap="goBooking"><text class="metric-value">{{bookingRequests.length}}</text><text class="metric-label">预约申请</text></view>
    </view>
    <button class="primary booking-button" bindtap="goBooking">预约课程 · 剩余 {{member.remainingLessons}} 节</button>
  </view>

  <view class="card hero-card">
    <view class="card-title">下一节课</view>
    <block wx:if="{{nextSchedule}}">
      <view class="row"><view><view class="name">{{nextSchedule.dayLabel}} {{nextSchedule.lessonTime}}</view><view class="meta">{{nextSchedule.campus}} · {{nextSchedule.coach}}</view></view><text class="badge {{nextSchedule.lessonStatus === 'completed' ? '' : 'warn'}}">{{nextSchedule.lessonStatus === 'completed' ? '完成' : '待上课'}}</text></view>
    </block>
    <view wx:else class="empty">还没有已确认课程，去预约一个合适时间</view>
    <button class="primary wide-action" bindtap="goBooking">去预约课程</button>
  </view>

  <view class="card">
    <view class="row"><view><view class="card-title">本周课程</view><view class="meta">显示未来 7 天已安排课程</view></view><button class="mini" bindtap="goRecords">消课记录</button></view>
    <block wx:if="{{weekSchedules.length}}"><view class="list-item" wx:for="{{weekSchedules}}" wx:key="id"><view class="row"><view><view class="name">{{item.dayLabel}} {{item.lessonTime}}</view><view class="meta">{{item.campus}} · {{item.coach}}</view></view><text class="badge {{item.lessonStatus === 'completed' ? '' : 'warn'}}">{{item.lessonStatus === 'completed' ? '完成' : '待上课'}}</text></view></view></block>
    <view wx:else class="empty">本周暂无课程</view>
  </view>

  <view class="card">
    <view class="card-title">课程申请</view>
    <view class="meta" wx:if="{{pendingApplications.length}}">已有 {{pendingApplications.length}} 个申请等待老板处理，请勿重复提交。</view>
    <view class="field">
      <text class="field-label">选择课程</text>
      <picker mode="selector" range="{{courseProducts}}" range-key="name" value="{{courseProductIndex}}" bindchange="productChange">
        <view class="picker-box">{{selectedProduct.name || '请选择课程'}} · {{selectedProduct.totalLessons || 0}} 课时</view>
      </picker>
    </view>
    <view class="field"><text class="field-label">备注</text><textarea value="{{courseNote}}" placeholder="例如：想续 20 次卡、希望保留当前教练" bindinput="noteInput" /></view>
    <button class="primary" bindtap="applyCourse">提交申请</button>
  </view>
</view>

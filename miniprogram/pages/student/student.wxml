<view class="page student-page">
  <view class="app-header">
    <view>
      <view class="eyebrow">我的课程</view>
      <view class="title">{{member.chineseName || viewer.fullName}}</view>
    </view>
    <view class="balance-pill" bindtap="goRecords">
      <text class="balance-number">{{member.remainingLessons || 0}}</text>
      <text class="balance-label">剩余课时</text>
    </view>
  </view>

  <view class="section calendar-section">
    <view class="section-head">
      <view><view class="section-title">选上课日期</view><view class="section-note">未来 21 天</view></view>
      <view class="calendar-actions">
        <view class="show-code-action {{primaryQrSchedule ? '' : 'muted'}}" bindtap="showPrimaryQr">展示上课码</view>
        <text class="text-link" bindtap="goRecords">全部记录</text>
      </view>
    </view>
    <view class="calendar-grid">
      <view class="date-tile {{selectedDate === item.value ? 'active' : ''}} {{item.hasSchedule ? 'scheduled' : ''}}" wx:for="{{calendarDays}}" wx:key="value" bindtap="selectDate" data-date="{{item.value}}">
        <text class="date-week">{{item.today ? '今天' : item.weekday}}</text>
        <text class="date-number">{{item.day}}</text>
        <view class="date-signals">
          <text wx:if="{{item.hasSchedule}}" class="signal course"></text>
          <text wx:if="{{item.hasPending}}" class="signal pending"></text>
          <text wx:if="{{item.availableCount && !item.hasSchedule && !item.hasPending}}" class="signal open"></text>
        </view>
      </view>
    </view>
    <view class="calendar-legend"><text><text class="legend-dot course"></text>已排课</text><text><text class="legend-dot pending"></text>待发布</text><text><text class="legend-dot open"></text>可选择</text></view>
  </view>

  <view class="day-heading">
    <view><text class="day-title">{{selectedDateLabel}}</text><text class="day-date">{{selectedDate}}</text></view>
  </view>

  <view class="section" wx:if="{{daySchedules.length}}">
    <view class="section-title">当天课程</view>
    <view class="lesson-card" wx:for="{{daySchedules}}" wx:key="id">
      <view class="lesson-time">{{item.lessonTime}}</view>
      <view class="lesson-main"><view class="lesson-title">{{item.productName || member.productName || '游泳课'}}</view><view class="lesson-meta">{{item.campus}} · {{item.coach}}</view></view>
      <text class="status {{item.statusClass}}">{{item.statusText}}</text>
      <view class="lesson-actions" wx:if="{{item.lessonStatus === 'pending'}}">
        <button wx:if="{{item.verificationStatus === 'active'}}" class="block-button primary" data-id="{{item.id}}" bindtap="showQr">上课码</button>
        <button class="block-button quiet" data-id="{{item.id}}" bindtap="requestLeave">请假</button>
      </view>
    </view>
  </view>

  <view class="section pending-section" wx:if="{{dayRequests.length}}">
    <view class="section-title">等待老板发布</view>
    <view class="draft-row" wx:for="{{dayRequests}}" wx:key="id"><view><view class="lesson-title">{{item.slotTime}} · {{item.productName || member.productName}}</view><view class="lesson-meta">{{item.campus}} · {{item.coach}}</view></view><text class="status warn">草稿</text></view>
  </view>

  <block wx:if="{{!daySchedules.length && !dayRequests.length}}">
    <view class="section flow-section">
      <view class="flow-step"><text>1</text><view><view class="section-title">选择地点</view><view class="section-note">已记住你的常用校区</view></view></view>
      <view class="choice-grid">
        <view class="choice-tile {{selectedCampus === item ? 'active' : ''}}" wx:for="{{campuses}}" wx:key="*this" bindtap="selectCampus" data-value="{{item}}"><text class="choice-title">{{item}}</text><text class="choice-meta">游泳馆</text></view>
      </view>
    </view>

    <view class="section flow-section">
      <view class="flow-step"><text>2</text><view><view class="section-title">选择课程</view><view class="section-note">按当前课卡智能预选</view></view></view>
      <view class="choice-grid">
        <view class="choice-tile course-choice {{selectedProductId === item.id ? 'active' : ''}}" wx:for="{{courseProducts}}" wx:key="id" bindtap="selectProduct" data-id="{{item.id}}"><text class="choice-title">{{item.name}}</text><text class="choice-meta">{{item.totalLessons || member.totalLessons || 0}} 课时</text></view>
      </view>
    </view>

    <view class="section flow-section">
      <view class="flow-step"><text>3</text><view><view class="section-title">选择教练时间</view><view class="section-note">只显示真正有空的时间</view></view></view>
      <view class="slot-list" wx:if="{{visibleSlots.length}}">
        <view class="slot-tile {{selectedSlotId === item.id ? 'active' : ''}}" wx:for="{{visibleSlots}}" wx:key="id" bindtap="selectSlot" data-id="{{item.id}}">
          <view><view class="slot-time">{{item.slotTime}}</view><view class="slot-meta">{{item.coach}} · {{item.campus}}</view></view><text class="slot-left">余 {{item.left}}</text>
        </view>
      </view>
      <view wx:else class="calm-empty">当天暂无可选时间，换个日期看看</view>
    </view>

    <view class="confirm-bar" wx:if="{{selectedSlot}}">
      <view><view class="confirm-title">{{selectedSlot.slotTime}} · {{selectedSlot.coach}}</view><view class="confirm-meta">{{selectedCampus}} · {{selectedProduct.name}}</view></view>
      <button class="confirm-button" loading="{{submitting}}" bindtap="confirmBooking">确定</button>
    </view>
  </block>

  <view class="utility-row"><text bindtap="goRecords">课时与历史</text><text bindtap="applyCourse">{{pendingApplications.length ? '续课处理中' : '申请续课'}}</text><text bindtap="logout">退出登录</text></view>

  <view class="modal-mask" wx:if="{{qrVisible}}" bindtap="hideQr">
    <view class="modal-card" catchtap="noop"><view class="modal-title">上课码</view><view class="modal-meta">{{qrSchedule.lessonDate}} {{qrSchedule.lessonTime}} · {{qrSchedule.campus}} · {{qrSchedule.coach}}</view><canvas class="qr-canvas" canvas-id="homeQrCanvas"></canvas><view class="qr-code-text">{{qrSchedule.verificationPayload}}</view><view class="modal-meta">请出示给教练扫码消课</view><button class="primary wide-action" bindtap="hideQr">完成</button></view>
  </view>
</view>

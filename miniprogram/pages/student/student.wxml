<view class="page student-page">
  <view class="developer-readonly" wx:if="{{viewer.developerReadOnly}}" bindtap="switchDeveloper"><text>只读</text><view>开发者正在查看学员视角</view><text>切换 ›</text></view>
  <view class="app-header"><view><view class="eyebrow">我的课时</view><view class="title">{{viewer.fullName || '学员家庭'}}</view></view></view>
  <view class="profile-strip" bindtap="openProfile" role="button" aria-label="查看或设置家长头像和昵称"><image wx:if="{{viewer.avatarFileId}}" src="{{viewer.avatarFileId}}" mode="aspectFill"></image><view wx:else class="profile-fallback">微</view><view><view class="profile-name">{{viewer.nickname || '补充家长头像和昵称'}}</view><view class="profile-note">一个手机号可管理多名孩子 · 微信{{viewer.wechatBound ? '已绑定' : '待绑定'}}</view></view><text>›</text></view>
  <view class="load-state" wx:if="{{loading}}"><view class="loading-line wide"></view><view class="loading-line"></view><view>正在读取孩子课时…</view></view>
  <view class="load-state load-error" wx:elif="{{loadError}}" role="alert"><view class="state-title">课时暂时没有读出来</view><view class="state-note">{{loadError}}</view><button class="mini" bindtap="retryLoad">重新读取</button></view>
  <block wx:else>
  <view class="scan-tip"><view class="scan-icon">扫</view><view class="scan-copy"><view class="scan-kicker">到场消课</view><view class="scan-title">扫描教练手机上的今日码</view><view class="scan-note">退出小程序后使用微信“扫一扫”</view></view><text class="scan-badge">微信扫码</text></view>
  <view class="member-card" wx:for="{{members}}" wx:key="id"><view class="member-head"><view class="member-name">{{item.chineseName}}</view><view class="remaining {{item.remainingLessons < 0 ? 'debt' : ''}}">{{item.remainingLessons < 0 ? '欠 ' + (0-item.remainingLessons) : '剩 ' + item.remainingLessons}} 节</view></view><view class="lesson-stats"><view><text>{{item.totalLessons}}</text><text>总课时</text></view><view><text>{{item.usedLessons}}</text><text>已上课时</text></view><view><text>{{item.remainingLessons}}</text><text>剩余课时</text></view></view></view>
  <view class="section"><view class="section-title">最近消课</view><view class="log-row {{item.status === 'reversed' ? 'reversed' : ''}}" wx:for="{{logs}}" wx:key="id"><view><view class="log-title">{{item.memberName}} · {{item.coach}}</view><view class="meta">{{item.attendanceDate}} {{item.attendanceTime || ''}}</view></view><view class="log-lessons">{{item.status === 'reversed' ? '已撤销' : '-' + item.lessonsDeducted + ' 节'}}</view></view><view wx:if="{{!logs.length}}" class="empty">暂无消课记录</view></view>
  </block>
  <view class="logout" bindtap="logout">退出登录</view>
  <view class="modal-mask profile-mask" wx:if="{{profileVisible}}" bindtap="closeProfile"><view class="modal-card profile-card" catchtap="noop"><view class="modal-title">头像与昵称</view><view class="modal-meta">头像属于家长账号，同一手机号下的孩子共用</view><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{profileAvatar}}" src="{{profileAvatar}}" mode="aspectFill"></image><view wx:else>选头像</view></button><view class="field"><text class="field-label">微信昵称</text><input type="nickname" maxlength="24" value="{{profileNickname}}" placeholder="请输入昵称" bindinput="profileNicknameInput" /></view><button class="primary wide-action" loading="{{profileSaving}}" bindtap="saveProfile">保存资料</button></view></view>
</view>

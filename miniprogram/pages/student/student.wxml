<view class="page student-page">
  <view class="app-header"><view><view class="eyebrow">我的课时</view><view class="title">{{viewer.fullName || '学员家庭'}}</view></view></view>
  <view class="scan-tip"><view class="scan-icon">扫</view><view class="scan-copy"><view class="scan-kicker">到场消课</view><view class="scan-title">扫描教练手机上的今日码</view><view class="scan-note">使用微信“扫一扫”，确认学员和课时</view></view><text class="scan-arrow">›</text></view>
  <view class="member-card" wx:for="{{members}}" wx:key="id"><view class="member-head"><view class="member-name">{{item.chineseName}}</view><view class="remaining {{item.remainingLessons < 0 ? 'debt' : ''}}">{{item.remainingLessons < 0 ? '欠 ' + (0-item.remainingLessons) : '剩 ' + item.remainingLessons}} 节</view></view><view class="lesson-stats"><view><text>{{item.totalLessons}}</text><text>总课时</text></view><view><text>{{item.usedLessons}}</text><text>已上课时</text></view><view><text>{{item.remainingLessons}}</text><text>剩余课时</text></view></view></view>
  <view class="section"><view class="section-title">最近消课</view><view class="log-row {{item.status === 'reversed' ? 'reversed' : ''}}" wx:for="{{logs}}" wx:key="id"><view><view class="log-title">{{item.memberName}} · {{item.coach}}</view><view class="meta">{{item.attendanceDate}} {{item.attendanceTime || ''}}</view></view><view class="log-lessons">{{item.status === 'reversed' ? '已撤销' : '-' + item.lessonsDeducted + ' 节'}}</view></view><view wx:if="{{!logs.length}}" class="empty">暂无消课记录</view></view>
  <view class="logout" bindtap="logout">退出登录</view>
</view>

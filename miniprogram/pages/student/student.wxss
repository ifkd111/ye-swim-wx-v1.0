.student-page{padding-bottom:80rpx}.scan-tip{display:flex;align-items:center;gap:20rpx;margin:22rpx 0;padding:26rpx;border-radius:24rpx;background:#153f39;color:#fff}.scan-icon{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:rgba(255,255,255,.14);font-size:44rpx}.scan-title{font-size:27rpx;font-weight:850}.scan-note{margin-top:7rpx;color:rgba(255,255,255,.68);font-size:21rpx}.member-card{margin-top:16rpx;padding:28rpx;border-radius:26rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(29,61,51,.07)}.member-head{display:flex;align-items:center;justify-content:space-between}.member-name{font-size:36rpx;font-weight:900}.remaining{padding:10rpx 16rpx;border-radius:14rpx;background:#e7f5ef;color:#176f63;font-weight:850}.remaining.debt{background:#fff0ed;color:#c24d3d}.lesson-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:26rpx;text-align:center}.lesson-stats>view+view{border-left:1rpx solid #e6ebe7}.lesson-stats text{display:block}.lesson-stats text:first-child{font-size:34rpx;font-weight:900}.lesson-stats text:last-child{margin-top:6rpx;color:#7b8781;font-size:21rpx}.log-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-top:1rpx solid #e8ece9}.log-row.reversed{opacity:.48}.log-title{font-size:26rpx;font-weight:800}.meta{margin-top:6rpx;color:#7b8781;font-size:21rpx}.log-lessons{font-weight:900;color:#176f63}.empty{padding:40rpx 0;text-align:center;color:#8a948f}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:23rpx}

.student-page{padding-bottom:80rpx}.scan-tip{position:relative;display:flex;align-items:center;gap:20rpx;overflow:hidden;margin:22rpx 0;padding:26rpx;border-radius:28rpx;background:linear-gradient(135deg,#174d41,#103a31);color:#fff;box-shadow:0 18rpx 36rpx rgba(22,67,57,.18)}.scan-tip::after{content:"";position:absolute;width:160rpx;height:160rpx;right:-75rpx;top:-80rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:50%}.scan-icon{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:22rpx;background:#d8b77b;color:#173e35;font-size:27rpx;font-weight:900}.scan-copy{min-width:0;flex:1}.scan-kicker{margin-bottom:5rpx;color:#d8b77b;font-size:18rpx;font-weight:900;letter-spacing:2rpx}.scan-title{font-size:27rpx;font-weight:900}.scan-note{margin-top:7rpx;color:rgba(255,255,255,.68);font-size:20rpx}.scan-arrow{font-size:42rpx;color:rgba(255,255,255,.72)}.member-card{position:relative;overflow:hidden;margin-top:16rpx;padding:29rpx;border:1rpx solid #e5e3dc;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(42,54,48,.055)}.member-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:7rpx;background:#347d6d}.member-head{display:flex;align-items:center;justify-content:space-between}.member-name{font-size:36rpx;font-weight:900}.remaining{padding:10rpx 16rpx;border-radius:14rpx;background:#e6f1ec;color:#1e6253;font-weight:900}.remaining.debt{background:#fff0ed;color:#b85040}.lesson-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:27rpx;padding-top:24rpx;border-top:1rpx solid #eceae3;text-align:center}.lesson-stats>view+view{border-left:1rpx solid #e9e7e0}.lesson-stats text{display:block}.lesson-stats text:first-child{font-size:34rpx;font-weight:900}.lesson-stats text:last-child{margin-top:6rpx;color:#7b8781;font-size:20rpx}.log-row{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-top:1rpx solid #ebe9e2}.log-row.reversed{opacity:.48}.log-title{font-size:26rpx;font-weight:900}.meta{margin-top:6rpx;color:#7b8781;font-size:21rpx}.log-lessons{font-weight:900;color:#246656}.empty{padding:40rpx 0;text-align:center;color:#8a948f}.logout{padding:28rpx;text-align:center;color:#7a8781;font-size:23rpx}

.student-page { padding-bottom: 180rpx; }
.balance-pill { min-width: 156rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: #153f39; color: #fff; text-align: center; }
.balance-number { display: block; font-size: 40rpx; line-height: 1; font-weight: 800; }
.balance-label { display: block; margin-top: 6rpx; font-size: 20rpx; opacity: .78; }
.calendar-section { padding-bottom: 20rpx; }
.calendar-actions { display: flex; align-items: center; gap: 20rpx; }
.show-code-action { padding: 13rpx 18rpx; border-radius: 14rpx; background: #176f63; color: #fff; font-size: 22rpx; font-weight: 800; }
.show-code-action.muted { background: #e7ebe8; color: #89928e; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.date-tile { min-height: 112rpx; padding: 13rpx 4rpx 8rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #f5f6f3; text-align: center; }
.date-tile.active { border-color: #176f63; background: #e9f4f1; color: #0c544b; }
.date-tile.scheduled:not(.active) { background: #eef3ff; }
.date-week { display: block; color: #78827d; font-size: 19rpx; }
.date-number { display: block; margin-top: 5rpx; font-size: 29rpx; font-weight: 800; }
.date-signals { height: 12rpx; margin-top: 8rpx; display: flex; justify-content: center; gap: 5rpx; }
.signal { width: 8rpx; height: 8rpx; border-radius: 50%; }
.signal.course, .legend-dot.course { background: #315dca; }
.signal.pending, .legend-dot.pending { background: #d28a13; }
.signal.open, .legend-dot.open { background: #1b8a72; }
.calendar-legend { display: flex; justify-content: center; gap: 26rpx; margin-top: 18rpx; color: #78827d; font-size: 20rpx; }
.calendar-legend text { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; }
.day-heading { margin: 32rpx 2rpx 18rpx; }
.day-title { margin-right: 16rpx; font-size: 38rpx; font-weight: 850; color: #182420; }
.day-date { color: #85908b; font-size: 23rpx; }
.lesson-card { display: grid; grid-template-columns: 118rpx 1fr auto; gap: 16rpx; align-items: center; padding: 20rpx 0; border-top: 1rpx solid #e8ebe7; }
.lesson-card:first-of-type { border-top: 0; }
.lesson-time { font-size: 27rpx; font-weight: 850; color: #176f63; }
.lesson-title { font-size: 28rpx; font-weight: 800; color: #182420; }
.lesson-meta { margin-top: 6rpx; color: #74807a; font-size: 22rpx; }
.lesson-actions { grid-column: 1 / 4; display: grid; grid-template-columns: 2fr 1fr; gap: 12rpx; }
.pending-section { border-left: 6rpx solid #d39122; }
.draft-row { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; }
.flow-section { margin-bottom: 16rpx; }
.flow-step { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.flow-step > text { width: 42rpx; height: 42rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; background: #e5efec; color: #176f63; font-weight: 850; }
.choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.choice-tile { min-height: 100rpx; padding: 18rpx; border: 2rpx solid #e3e8e4; border-radius: 18rpx; background: #fafbf9; }
.choice-tile.active { border-color: #176f63; background: #edf6f3; }
.choice-title, .choice-meta { display: block; }
.choice-title { font-size: 27rpx; font-weight: 800; }
.choice-meta { margin-top: 5rpx; color: #7a857f; font-size: 21rpx; }
.slot-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.slot-tile { min-height: 112rpx; padding: 18rpx; display: flex; align-items: center; justify-content: space-between; gap: 10rpx; border: 2rpx solid #e3e8e4; border-radius: 18rpx; background: #fafbf9; }
.slot-tile.active { border-color: #176f63; background: #e7f4f0; }
.slot-time { font-size: 26rpx; font-weight: 850; }
.slot-meta { margin-top: 7rpx; color: #74807a; font-size: 20rpx; }
.slot-left { color: #176f63; font-size: 20rpx; font-weight: 800; }
.confirm-bar { position: fixed; z-index: 10; left: 24rpx; right: 24rpx; bottom: 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 20rpx 20rpx 24rpx; border-radius: 24rpx; background: #172520; color: #fff; box-shadow: 0 16rpx 46rpx rgba(15, 37, 31, .28); }
.confirm-title { font-size: 27rpx; font-weight: 800; }
.confirm-meta { margin-top: 5rpx; color: rgba(255,255,255,.65); font-size: 20rpx; }
.confirm-button { min-width: 150rpx; background: #54c4a8; border-color: #54c4a8; color: #0d2e27; }
.calm-empty { padding: 38rpx 12rpx; color: #89928e; text-align: center; font-size: 23rpx; }
.utility-row { display: flex; justify-content: center; gap: 56rpx; padding: 28rpx 0; color: #6f7b75; font-size: 23rpx; }
.qr-canvas { width: 220px; height: 220px; margin: 28rpx auto; }
.qr-code-text { margin: -8rpx auto 16rpx; color: #176f63; font-size: 22rpx; font-weight: 800; text-align: center; letter-spacing: 1rpx; }
